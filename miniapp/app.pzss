/* ---------------------------------------------------------------------------
   Tá Pago! — base. Marca: limão #C6F432 + preto #111111 (ta-pago-logo.zip).
   Light: fundo gelo #F2F2EF, cartões brancos, ação em preto (botões e pílulas
   ativas), limão SÓ no destaque (cartão do dia, tá pago dado, comemoração).
   750rpx = largura da tela. Cores sempre literais (sem var()).
   --------------------------------------------------------------------------- */
page {
  background: #F2F2EF;
  overflow-x: hidden;
  color: #111111;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 30rpx;
  line-height: 1.35;
  -webkit-font-smoothing: antialiased;
  letter-spacing: -0.6rpx;
}
.pop { font-family: "Poppins", -apple-system, BlinkMacSystemFont, sans-serif; }
/* Número esportivo: Poppins pesada com a inclinação do logo. */
.num { font-family: "Unbounded", "Poppins", -apple-system, sans-serif; font-weight: 800; letter-spacing: -2rpx; display: inline-block; }
.larga { font-family: "Unbounded", "Poppins", -apple-system, sans-serif; font-weight: 800; letter-spacing: -1.4rpx; }
.rotulo { font-size: 22rpx; font-weight: 700; letter-spacing: 2rpx; text-transform: uppercase; color: #111111; }
.etiqueta { display: inline-flex; align-items: center; height: 48rpx; padding: 0 20rpx; border-radius: 999rpx; background: #111111; color: #FFFFFF; font-size: 22rpx; font-weight: 700; letter-spacing: 1rpx; text-transform: uppercase; }
.btn-sec { height: 104rpx; border-radius: 999rpx; background: #FFFFFF; color: #111111; font-weight: 600; font-size: 32rpx; display: flex; align-items: center; justify-content: center; }
.btn-esc { height: 104rpx; border-radius: 999rpx; background: transparent; box-shadow: inset 0 0 0 3rpx #111111; color: #111111; font-weight: 600; font-size: 32rpx; display: flex; align-items: center; justify-content: center; }

.av { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 88rpx; height: 88rpx; border-radius: 999rpx; color: #FFFFFF; font-weight: 600; font-size: 32rpx; }

.barra { position: relative; display: flex; align-items: center; justify-content: center; }
.barra-voltar { position: absolute; left: 12rpx; width: 80rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; }
.barra-voltar image { width: 52rpx; height: 52rpx; }
/* Troca de ranking (Geral/Semana/Mês, grupo): a lista sai rápido e as linhas entram uma a uma */
.rk-sai { opacity: .2; transform: translateY(12rpx); transition: opacity .16s ease-out, transform .16s ease-out; }
.rk-volta { transition: opacity .2s ease-out, transform .2s ease-out; }
.rk-entra { animation: rk-entra .46s cubic-bezier(.2,.9,.2,1) both; }
@keyframes rk-entra { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: none; } }
.rk-pula { animation: rk-pula .5s cubic-bezier(.3,1.5,.5,1) both; }
@keyframes rk-pula { from { opacity: 0; transform: translateY(40rpx) scale(.92); } to { opacity: 1; transform: none; } }
/* Seletor com pílula que desliza */
.seg { position: relative; }
.seg-th { position: absolute; top: 6rpx; bottom: 6rpx; left: 6rpx; border-radius: 999rpx; background: #FFFFFF; box-shadow: 0 2rpx 8rpx rgba(17,17,17,.08); transition: transform .32s cubic-bezier(.3,1.2,.4,1); }
.seg .seg-i { position: relative; z-index: 1; transition: color .2s; }
.seg .seg-i.on { background: transparent; box-shadow: none; }

/* Enfeite do tema do dia por cima do avatar (chapéu, gorro…): posição e tamanho em % do avatar, vindos do servidor */
.enf-w { position: relative; display: flex; flex-shrink: 0; }
.enf { position: absolute; z-index: 3; pointer-events: none; }

/* Voltar solto no topo (telas e camadas sem barra) */
.ov-voltar { position: absolute; left: 12rpx; z-index: 5; width: 80rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; }
.ov-voltar image { width: 52rpx; height: 52rpx; }
.barra-tit { font-weight: 600; font-size: 34rpx; color: #111111; }

.sec { display: block; padding: 56rpx 40rpx 20rpx; font-family: "Unbounded", "Poppins", -apple-system, sans-serif; font-weight: 800; font-size: 34rpx; letter-spacing: -1rpx; color: #111111; }
.nota { display: block; margin: 32rpx 40rpx 0; font-size: 26rpx; line-height: 36rpx; color: #7A7A76; }
.erro { display: block; margin: 24rpx 40rpx 0; font-size: 28rpx; color: #E5484D; }

/* "style": "v2" (app.json) dá estilo de sistema pro <button> (largura ~184px, fundo cinza, padding,
   line-height próprio). Aqui zera tudo; cada botão ganha a cara pela classe dele. */
button, button:not([size='mini']) { position: relative; display: flex; align-items: center; justify-content: center; box-sizing: border-box;
  width: auto; min-width: 0; height: auto; margin: 0; padding: 0; line-height: normal; font-size: inherit; font-weight: inherit;
  color: inherit; background: transparent; border: none; border-radius: 0; text-align: center; overflow: visible; }
button::after { display: none; border: none; }
button[type], button[plain] { background: transparent; color: inherit; }
.button-hover { background-color: transparent; opacity: .8; }

.btn, button.btn:not([size='mini']) { height: 112rpx; border-radius: 999rpx; background: #111111; color: #FFFFFF; font-weight: 600; font-size: 32rpx; display: flex; align-items: center; justify-content: center; }
.btn.off, button.btn.off:not([size='mini']) { background: #E2E2DE; color: #A5A5A0; }
.btn-press { opacity: .85; transform: scale(.99); }

.chips { display: flex; flex-wrap: wrap; padding: 0 40rpx; }
.chip { height: 76rpx; padding: 0 32rpx; margin: 0 12rpx 12rpx 0; border-radius: 999rpx; background: #FFFFFF; box-shadow: 0 4rpx 14rpx rgba(17,17,17,.05); color: #3A3A38; font-weight: 500; font-size: 28rpx; display: flex; align-items: center; }
.chip.on { background: #111111; box-shadow: none; color: #FFFFFF; font-weight: 600; }

.rodape { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; padding: 24rpx 40rpx 40rpx; background: linear-gradient(180deg, rgba(242,242,239,0), #F2F2EF 30%); }

.toast { position: fixed; left: 32rpx; right: 32rpx; z-index: 200; padding: 26rpx 32rpx; border-radius: 32rpx; background: #111111; color: #FFFFFF; font-weight: 600; font-size: 30rpx; line-height: 40rpx; }

/* ── Card do treino (sem foto): escuro, categoria num selo limão, número grande; com trajeto, mapa escuro ── */
.tc { position: relative; height: 356rpx; margin-top: 20rpx; padding: 32rpx; box-sizing: border-box; border-radius: 32rpx; overflow: hidden; background: #141414; color: #FFFFFF; }
.tc-mapa { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.tc-marca { position: absolute; right: -24rpx; top: 40rpx; width: 240rpx; height: 240rpx; opacity: .05; }
/* Brilho limão no canto de baixo à direita (no card com mapa, o servidor já desenha embaixo da rota). */
.tc-brilho { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background: radial-gradient(75% 115% at 100% 100%, rgba(198,244,50,.8) 0%, rgba(198,244,50,.38) 30%, rgba(198,244,50,.12) 62%, rgba(198,244,50,0) 100%); }
.tc-topo { position: relative; display: flex; align-items: center; }
.tc-chip { width: 52rpx; height: 52rpx; border-radius: 999rpx; background: #C6F432; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.tc-chip image { width: 30rpx; height: 30rpx; }
.tc-tipo { margin-left: 16rpx; font-weight: 600; font-size: 26rpx; }
.tc-hero { position: relative; display: flex; align-items: baseline; margin-top: 24rpx; }
.tc-v { font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 92rpx; line-height: 96rpx; letter-spacing: -3rpx; }
.tc-u { margin-left: 10rpx; font-weight: 600; font-size: 30rpx; color: rgba(255,255,255,.55); }
.tc-stats { position: absolute; left: 32rpx; bottom: 28rpx; display: flex; }
.tc-s { margin-right: 40rpx; display: flex; flex-direction: column; }
.tc-sv { font-weight: 600; font-size: 28rpx; line-height: 34rpx; }
.tc-sr { margin-top: 2rpx; font-size: 20rpx; line-height: 26rpx; color: rgba(255,255,255,.5); }
.tc-pw { position: absolute; right: 28rpx; bottom: 32rpx; width: 184rpx; height: 18rpx; opacity: .9; }
.tc-mini { width: 96rpx; height: 96rpx; border-radius: 24rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: #141414; }
.tc-mini image { width: 48rpx; height: 48rpx; }
