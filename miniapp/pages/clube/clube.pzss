/* Página do grupo (light). O ranking é o centro: pódio grande, depois a lista. */
.tela { min-height: 100vh; box-sizing: border-box; background: #F2F2EF; overflow-x: hidden; }

.cab { padding: 24rpx 40rpx 0; }
.nome { display: block; font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 64rpx; line-height: 72rpx; letter-spacing: -2rpx; text-transform: uppercase; color: #111111; }
.info { display: flex; margin-top: 12rpx; font-size: 28rpx; }
.info-m { font-weight: 600; color: #111111; }
.info-p { margin-left: 8rpx; color: #7A7A76; }
.cab-pe { display: flex; align-items: center; justify-content: space-between; margin-top: 28rpx; }
.rostos { display: flex; }
.rosto { width: 64rpx; height: 64rpx; margin-right: -16rpx; border-radius: 999rpx; box-shadow: 0 0 0 4rpx #F2F2EF; display: flex; align-items: center; justify-content: center; color: #FFFFFF; font-size: 22rpx; font-weight: 600; }
.rosto.mais { background: #111111; font-size: 20rpx; }
.acoes { display: flex; align-items: center; }
.b-cod { height: 68rpx; line-height: 68rpx; padding: 0 24rpx; margin-right: 12rpx; border-radius: 999rpx; background: #E4E4E0; font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 22rpx; letter-spacing: 3rpx; color: #111111; }
.b-conv, button.b-conv:not([size='mini']) { margin: 0; height: 68rpx; display: flex; align-items: center; line-height: 68rpx; padding: 0 30rpx; border-radius: 999rpx; background: #111111; color: #FFFFFF; font-weight: 600; font-size: 26rpx; border: none; }
.b-conv::after { border: none; }

.seg { display: flex; margin: 24rpx 40rpx 0; padding: 6rpx; border-radius: 999rpx; background: #E9E9E5; }
.seg-i { flex: 1; height: 68rpx; border-radius: 999rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 500; color: #7A7A76; }
.seg .seg-th { width: calc((100% - 12rpx) / 3); }
.seg-i.on { background: #FFFFFF; color: #111111; font-weight: 600; box-shadow: 0 2rpx 8rpx rgba(17,17,17,.08); }

/* Pódio: 2º · 1º · 3º */
.podio { display: flex; align-items: flex-end; justify-content: center; margin: 48rpx 40rpx 0; }
.pd { flex: 1; display: flex; flex-direction: column; align-items: center; margin: 0 8rpx; }
.pd-av { position: relative; }
.pd-img { width: 104rpx; height: 104rpx; border-radius: 999rpx; box-shadow: 0 0 0 6rpx #FFFFFF; display: flex; align-items: center; justify-content: center; color: #FFFFFF; font-size: 34rpx; font-weight: 600; }
.pd-1 .pd-img { width: 132rpx; height: 132rpx; box-shadow: 0 0 0 6rpx #C6F432; }
.pd-coroa { position: absolute; left: 50%; top: -40rpx; margin-left: -22rpx; font-size: 40rpx; }
.pd-nome { margin-top: 14rpx; max-width: 200rpx; font-weight: 600; font-size: 26rpx; color: #111111; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pd-bloco { position: relative; width: 100%; margin-top: 14rpx; border-radius: 32rpx 32rpx 0 0; background: #FFFFFF; display: flex; flex-direction: column; align-items: center; padding-top: 24rpx; overflow: hidden; }
.pd-1 .pd-bloco { height: 320rpx; background: #C6F432; }
.pd-2 .pd-bloco { height: 260rpx; }
.pd-3 .pd-bloco { height: 220rpx; }
.pd-n { font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 72rpx; line-height: 80rpx; letter-spacing: -2rpx; color: #111111; }
.pd-1 .pd-n { font-size: 96rpx; line-height: 104rpx; }
.pd-pe { position: absolute; left: 0; right: 0; bottom: 20rpx; display: flex; flex-direction: column; align-items: center; }
.pd-v { font-weight: 600; font-size: 26rpx; line-height: 34rpx; color: #111111; white-space: nowrap; }
.pd-u { font-size: 22rpx; line-height: 30rpx; color: #7A7A76; white-space: nowrap; }
.pd-1 .pd-u { color: #3A4A10; }
.pd.eu .pd-nome { text-decoration: underline; }

.falta { display: flex; align-items: center; margin: 32rpx 40rpx 0; padding: 22rpx 28rpx; border-radius: 32rpx; background: #FFFFFF; box-shadow: 0 6rpx 20rpx rgba(17,17,17,.05); }
.falta-pos { min-width: 104rpx; height: 104rpx; border-radius: 26rpx; background: #C6F432; display: flex; align-items: center; justify-content: center; font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 40rpx; color: #111111; margin-right: 24rpx; flex-shrink: 0; }

.caixa { margin: 24rpx 40rpx 0; padding: 8rpx 0; border-radius: 40rpx; background: #FFFFFF; }
.linha { display: flex; align-items: center; height: 120rpx; padding: 0 28rpx; border-top: 2rpx solid #EEEEEA; }
.linha:first-child { border-top: none; }
.linha.eu { background: #F4FBDD; }
.linha.eu .pos { color: #111111; }
.pos { width: 64rpx; font-weight: 600; font-size: 28rpx; color: #A5A5A0; }
.av { width: 76rpx; height: 76rpx; font-size: 26rpx; color: #FFFFFF; }
.tx { flex: 1; min-width: 0; margin-left: 20rpx; display: flex; flex-direction: column; }
.tx-b { font-weight: 600; font-size: 30rpx; line-height: 38rpx; color: #111111; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.tx-s { font-size: 24rpx; line-height: 32rpx; color: #7A7A76; }
.val { font-weight: 600; font-size: 30rpx; color: #111111; white-space: nowrap; }
.val-u { font-weight: 400; font-size: 22rpx; color: #7A7A76; }

.chamar { display: flex; align-items: center; justify-content: space-between; margin: 24rpx 40rpx 0; padding: 24rpx 28rpx; border-radius: 32rpx; background: #FFFFFF; }
.chamar-t { font-size: 26rpx; color: #6A6A66; }

/* Feed */
.post { margin: 0 40rpx 20rpx; padding: 24rpx; border-radius: 40rpx; background: #FFFFFF; }
.post-cab { display: flex; align-items: center; }
.av-p { width: 72rpx; height: 72rpx; border-radius: 999rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; color: #FFFFFF; font-size: 26rpx; font-weight: 600; }
.post-foto { display: block; width: 100%; height: 520rpx; margin-top: 20rpx; border-radius: 28rpx; background: #E4E4DF; }
.post-l { display: block; margin: 18rpx 4rpx 0; font-weight: 600; font-size: 28rpx; color: #111111; }
.tp { height: 64rpx; min-width: 64rpx; padding: 0 18rpx; box-sizing: border-box; border-radius: 999rpx; background: #EDEDEA; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-weight: 600; font-size: 24rpx; color: #111111; }
.tp image { width: 30rpx; height: 30rpx; }
.tp text { margin-left: 8rpx; }
.tp.on { background: #C6F432; }
.tp-press { opacity: .7; }

.sair { margin: 40rpx 40rpx 0; height: 88rpx; display: flex; align-items: center; justify-content: center; color: #E5484D; font-weight: 600; font-size: 28rpx; }

.flut { position: fixed; right: 40rpx; bottom: 56rpx; z-index: 30; height: 96rpx; padding: 0 36rpx 0 28rpx; border-radius: 999rpx; background: #C6F432; display: flex; align-items: center; box-shadow: 0 16rpx 40rpx rgba(120,160,10,.35); }
.flut image { width: 36rpx; height: 36rpx; }
.flut text { margin-left: 10rpx; color: #111111; font-weight: 600; font-size: 28rpx; }

.estado { display: flex; flex-direction: column; align-items: center; padding: 160rpx 56rpx; text-align: center; }
.estado-tx { font-size: 28rpx; line-height: 40rpx; color: #7A7A76; }
.estado-btn { margin-top: 48rpx; width: 100%; }
.spinner { width: 56rpx; height: 56rpx; border-radius: 999rpx; border: 6rpx solid #E6E6E2; border-top-color: #111111; animation: gira .8s linear infinite; }
@keyframes gira { to { transform: rotate(360deg); } }

.tx-l { display: flex; align-items: center; min-width: 0; }
.selo { width: 28rpx; height: 28rpx; margin-left: 8rpx; flex-shrink: 0; }
.pd-nl { display: flex; align-items: center; margin-top: 14rpx; max-width: 220rpx; }
.pd-nl .pd-nome { margin-top: 0; }
.taca { margin-left: 8rpx; font-size: 22rpx; font-weight: 700; color: #111111; flex-shrink: 0; }

/* Cutucar (só no grupo) */
.cut { height: 56rpx; margin-left: 14rpx; padding: 0 18rpx; border-radius: 999rpx; box-shadow: inset 0 0 0 2rpx #111111; display: flex; align-items: center; flex-shrink: 0; }
.cut text { font-size: 22rpx; font-weight: 600; color: #111111; white-space: nowrap; }
.cut.on { box-shadow: none; background: #EDEDEA; }
.cut.on text { color: #A5A5A0; }
.pd-cut { margin: 10rpx 0 0; }
.tp-press { opacity: .7; }

/* Seletor de amigos do PhizChat */
.cv { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 60; display: flex; align-items: flex-end; }
.cv-fundo { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background: rgba(17,17,17,.45); }
.cv-card { position: relative; width: 100%; box-sizing: border-box; padding: 20rpx 40rpx 56rpx; border-radius: 56rpx 56rpx 0 0; background: rgba(242,242,239,.96); -webkit-backdrop-filter: blur(24px); backdrop-filter: blur(24px); animation: cv-sobe .38s cubic-bezier(.2,1.2,.4,1) both; }
@keyframes cv-sobe { from { transform: translateY(100%); } }
.cv-alca { width: 72rpx; height: 10rpx; margin: 0 auto 24rpx; border-radius: 999rpx; background: #D6D6D2; }
.cv-t { display: block; font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 36rpx; letter-spacing: -.8rpx; color: #111111; }
.cv-s { display: block; margin-top: 12rpx; font-size: 26rpx; line-height: 38rpx; color: #6A6A66; }
.cv-carr { display: flex; justify-content: center; padding: 80rpx 0; }
.cv-lista { height: 760rpx; margin-top: 20rpx; }
.cv-i { display: flex; align-items: center; padding: 18rpx 8rpx; border-radius: 28rpx; }
.cv-i.on { background: rgba(198,244,50,.35); }
.cv-i.off { opacity: .55; }
.cv-av { width: 80rpx; height: 80rpx; border-radius: 999rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; color: #FFFFFF; font-weight: 600; font-size: 28rpx; }
.cv-n { flex: 1; min-width: 0; margin-left: 20rpx; font-weight: 600; font-size: 30rpx; color: #111111; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cv-tag { font-size: 22rpx; font-weight: 600; color: #7A7A76; }
.cv-ck { width: 48rpx; height: 48rpx; border-radius: 999rpx; box-shadow: inset 0 0 0 3rpx #CFCFCA; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.cv-i.on .cv-ck { background: #C6F432; box-shadow: none; }
.cv-ck image { width: 26rpx; height: 26rpx; }
.cv-btn { margin-top: 24rpx; }
button.cv-btn:not([size='mini']) { margin-top: 24rpx; }
.cv-link { margin-top: 8rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 26rpx; color: #7A7A76; }
.post-st { display: flex; align-items: center; justify-content: space-between; margin: 10rpx 4rpx 0; }
.ver-st { font-weight: 700; font-size: 24rpx; color: #FC5200; }
.pw-st { width: 240rpx; height: 24rpx; }
.b-share { width: 68rpx; height: 68rpx; border-radius: 999rpx; background: #FFFFFF; box-shadow: 0 4rpx 14rpx rgba(17,17,17,.08); display: flex; align-items: center; justify-content: center; }
.b-share image { width: 34rpx; height: 34rpx; }
.falta-col { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.falta-rot { font-size: 24rpx; line-height: 32rpx; color: #7A7A76; }
.falta-b { font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 36rpx; line-height: 46rpx; letter-spacing: -1rpx; color: #111111; }
.falta-tx { margin-top: 4rpx; font-size: 26rpx; line-height: 36rpx; color: #3A3A38; }
.ver-mais { height: 96rpx; border-top: 2rpx solid #EEEEEA; display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 28rpx; color: #111111; }

.nome-l { display: flex; align-items: flex-start; justify-content: space-between; }
.nome-l .nome { flex: 1; min-width: 0; }
.b-ed { margin: 8rpx 0 0 16rpx; height: 60rpx; padding: 0 24rpx; border-radius: 999rpx; background: #FFFFFF; display: flex; align-items: center; flex-shrink: 0; }
.b-ed text { font-weight: 600; font-size: 24rpx; color: #111111; }
.desafio { display: inline-block; margin-top: 14rpx; font-size: 24rpx; font-weight: 600; color: #6A6A66; }
.post-st-card { position: relative; height: 300rpx; margin-top: 20rpx; border-radius: 28rpx; overflow: hidden; background: linear-gradient(150deg, #1B1530 0%, #2A1660 55%, #FC5200 140%); display: flex; flex-direction: column; justify-content: center; padding: 0 36rpx; }
.pst-t { font-size: 26rpx; font-weight: 600; color: rgba(255,255,255,.75); }
.pst-p { margin-top: 4rpx; font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 72rpx; letter-spacing: -2rpx; color: #C6F432; }
.pst-pw { position: absolute; right: 28rpx; bottom: 24rpx; width: 220rpx; height: 22rpx; }
/* Editar grupo */
.ed-r { display: block; margin: 28rpx 0 12rpx; font-size: 24rpx; font-weight: 600; color: #7A7A76; }
.ed-in { height: 96rpx; padding: 0 28rpx; border-radius: 28rpx; background: #FFFFFF; font-size: 30rpx; font-weight: 600; color: #111111; }
.ed-chips { display: flex; flex-wrap: wrap; }
.ed-c { height: 72rpx; padding: 0 28rpx; margin: 0 12rpx 12rpx 0; border-radius: 999rpx; background: #FFFFFF; display: flex; align-items: center; font-weight: 600; font-size: 26rpx; color: #7A7A76; }
.ed-c.on { background: #C6F432; color: #111111; }
.ed-datas { display: flex; margin-top: 4rpx; }
.ed-d { flex: 1; margin-right: 12rpx; }
.ed-d:last-child { margin-right: 0; }
.ed-dv { padding: 18rpx 24rpx; border-radius: 28rpx; background: #FFFFFF; display: flex; flex-direction: column; }
.ed-dl { font-size: 22rpx; color: #7A7A76; }
.ed-dt { margin-top: 4rpx; font-weight: 600; font-size: 28rpx; color: #111111; }
