<view class="cm">
  <view class="ov-voltar" style="top: {{barTop - 4}}px" bindtap="avancar"><image src="{{ic.VOLTAR}}" mode="aspectFit"></image></view>
  <view class="cm-topo" style="padding-top: {{conteudoTop}}px">
    <image class="cm-icone" src="{{icone}}" mode="aspectFit"></image>
    <text class="cm-oi pop">Bem-vindo{{nome ? ", " + nome : ""}}!</text>
    <text class="cm-tx">Treine, ganhe pontos e veja quem está treinando com você.</text>
  </view>

  <text class="sec">Conecte seus treinos</text>
  <view class="cm-lista">
    <view class="cm-l">
      <image class="cm-l-ic" src="{{marcas.STRAVA}}" mode="aspectFit"></image>
      <view class="cm-l-tx"><text class="cm-l-b">Strava</text><text class="cm-l-s {{strava ? 'ok' : ''}}">{{strava ? "Conectado" : "Seus treinos entram sozinhos"}}</text></view>
      <view wx:if="{{strava}}" class="on"><view class="on-dot"></view><text>ON</text></view>
    </view>
    <!-- Botão oficial do Strava (arte deles, sem alterar) -->
    <image wx:if="{{!strava}}" class="st-btn {{ocupado ? 'carregando' : ''}}" src="/images/strava-connect.png" mode="aspectFit" bindtap="strava"></image>
    <text wx:if="{{!strava}}" class="st-nav" bindtap="stravaNavegador">Não abriu? Conectar pelo navegador</text>
    <view class="cm-l" bindtap="garmin" hover-class="btn-press">
      <image class="cm-l-ic" src="{{marcas.GARMIN}}" mode="aspectFit"></image>
      <view class="cm-l-tx"><text class="cm-l-b">Garmin e outros relógios</text><text class="cm-l-s">Pelo Strava, por enquanto</text></view>
      <view class="cm-btn sec">Como ligar</view>
    </view>
  </view>
  <text class="cm-dica">Sem relógio? Dá pra registrar o treino com uma foto.</text>

  <view style="height: 220rpx"></view>
  <view class="rodape">
    <view class="btn {{indo ? 'indo' : ''}}" bindtap="avancar" hover-class="btn-press" hover-start-time="0" hover-stay-time="80">{{indo ? "Entrando…" : "Avançar"}}</view>
  </view>
</view>
