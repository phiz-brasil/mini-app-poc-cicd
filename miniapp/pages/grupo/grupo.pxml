<view class="tela-b">
  <view class="barra" style="padding-top: {{barTop}}px; height: {{barH}}px">
    <view class="barra-voltar" style="top: {{barTop - 4}}px" bindtap="voltar"><image src="{{ic.VOLTAR}}" mode="aspectFit"></image></view>
    <text class="barra-tit">{{modoEntrar ? "Entrar num grupo" : (grupo ? "Grupo criado" : "Novo grupo")}}</text>
  </view>

  <block wx:if="{{modoEntrar}}">
    <view class="gp-topo">
      <text class="etiqueta">Convite</text>
      <text class="larga gp-tit">Recebeu um código?</text>
      <text class="gp-tx">Digite o código que te mandaram e você entra direto no grupo.</text>
    </view>
    <view class="gp-campo">
      <input class="gp-in gp-in-cod" value="{{codigo}}" placeholder="Ex.: ST6ZKY" placeholder-class="gp-ph" maxlength="6" confirm-type="go" bindinput="onCodigo" bindconfirm="entrar" />
    </view>
    <text class="erro" wx:if="{{erro}}">{{erro}}</text>
    <view class="rodape">
      <view class="btn {{codigo.length >= 6 && !criando ? '' : 'off'}}" bindtap="entrar" hover-class="btn-press">{{criando ? "Entrando…" : "Entrar no grupo"}}</view>
    </view>
  </block>

  <block wx:elif="{{!grupo}}">
    <view class="gp-topo">
      <text class="etiqueta">Grupo de treino</text>
      <text class="larga gp-tit">Treinar junto é mais fácil</text>
      <text class="gp-tx">Crie o grupo e chame a galera pelo chat. Cada um treina do seu jeito e vocês disputam o ranking.</text>
    </view>
    <view class="gp-campo">
      <input class="gp-in" value="{{nome}}" placeholder="Nome do grupo" placeholder-class="gp-ph" maxlength="32" confirm-type="done" bindinput="onNome" bindconfirm="criar" />
    </view>
    <view class="chips gp-ideias">
      <view wx:for="{{ideias}}" wx:key="*this" class="chip {{nome === item ? 'on' : ''}}" data-n="{{item}}" bindtap="usarIdeia">{{item}}</view>
    </view>
    <text class="sec">Como o grupo conta</text>
    <view class="gp-metricas">
      <view wx:for="{{metricas}}" wx:key="k" class="gp-m {{metrica === item.k ? 'on' : ''}}" data-k="{{item.k}}" bindtap="escolherMetrica">
        <view class="gp-m-tx"><text class="gp-m-b">{{item.l}}</text><text class="gp-m-s">{{item.s}}</text></view>
        <view class="gp-radio"><view class="gp-radio-in"></view></view>
      </view>
    </view>
    <text class="sec">Duração do desafio</text>
    <view class="chips">
      <view class="chip {{!comData ? 'on' : ''}}" data-v="0" bindtap="escolherDuracao">Sem data</view>
      <view class="chip {{comData ? 'on' : ''}}" data-v="1" bindtap="escolherDuracao">Com início e fim</view>
    </view>
    <text class="gp-dica" wx:if="{{!comData}}">O ranking do grupo não acaba: vale o Geral, a semana e o mês.</text>
    <block wx:else>
      <view class="gp-datas">
        <picker mode="date" value="{{inicio}}" start="{{hoje}}" bindchange="onInicio" class="gp-d">
          <view class="gp-dv"><text class="gp-dl">Início</text><text class="gp-dt">{{inicioTxt}}</text></view>
        </picker>
        <picker mode="date" value="{{fim}}" start="{{inicio}}" bindchange="onFim" class="gp-d">
          <view class="gp-dv"><text class="gp-dl">Fim</text><text class="gp-dt">{{fimTxt}}</text></view>
        </picker>
      </view>
      <view class="chips gp-prazos">
        <view wx:for="{{prazos}}" wx:key="k" class="chip {{prazo === item.k ? 'on' : ''}}" data-k="{{item.k}}" bindtap="escolherPrazo">{{item.l}}</view>
      </view>
      <text class="gp-dica">Fora dessas datas os treinos não contam pro ranking do grupo. Dá pra mudar depois em Editar.</text>
    </block>
    <text class="erro" wx:if="{{erro}}">{{erro}}</text>
    <view style="height: 240rpx"></view>
    <view class="rodape">
      <view class="btn {{nome.length >= 2 && !criando ? '' : 'off'}}" bindtap="criar" hover-class="btn-press">{{criando ? "Criando…" : "Criar grupo"}}</view>
    </view>
  </block>

  <block wx:else>
    <view class="gp-ok">
      <view class="gp-selo"><image src="{{ic.CHECK_PRETO}}" mode="aspectFit"></image></view>
      <text class="larga gp-ok-n">{{grupo.nome}}</text>
      <text class="gp-tx">Conta {{metricaTxt}}. {{desafioTxt}} Agora é só chamar a galera. Quem tocar no convite entra direto no grupo.</text>
      <view class="gp-cod"><text class="gp-cod-l">Código do convite</text><text class="num gp-cod-v">{{grupo.codigo}}</text></view>
    </view>
    <view class="rodape gp-acoes">
      <view class="btn gp-share" bindtap="convidarAmigos" hover-class="btn-press">Convidar amigos do PhizChat</view>
      <view class="btn-sec gp-copiar" bindtap="copiarConvite" hover-class="btn-press">Copiar convite com o código</view>
      <view class="btn-esc" bindtap="verRanking" hover-class="btn-press">Ver o ranking do grupo</view>
    </view>
  </block>
</view>
