.tela-b { min-height: 100vh; background: #F2F2EF; }
.gp-topo { padding: 40rpx 40rpx 0; display: flex; flex-direction: column; align-items: flex-start; }
.gp-tit { margin-top: 32rpx; font-size: 56rpx; line-height: 66rpx; color: #111111; }
.gp-tx { display: block; margin-top: 16rpx; font-size: 30rpx; line-height: 44rpx; color: #6A6A66; }
.gp-campo { margin: 48rpx 40rpx 0; height: 120rpx; padding: 0 32rpx; border-radius: 40rpx; background: #FFFFFF; display: flex; align-items: center; }
.gp-in { flex: 1; font-size: 36rpx; font-weight: 600; color: #111111; }
.gp-ph { color: #A5A5A0; }
.gp-ideias { margin-top: 28rpx; }

.gp-ok { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 80rpx 48rpx 0; }
.gp-selo { width: 168rpx; height: 168rpx; border-radius: 52rpx; background: #C6F432; display: flex; align-items: center; justify-content: center; box-shadow: 0 24rpx 60rpx rgba(17,17,17,.12); animation: entra .7s cubic-bezier(.2,1.6,.4,1) both; }
.gp-selo image { width: 96rpx; height: 96rpx; }
@keyframes entra { from { transform: scale(.4) rotate(-12deg); opacity: 0; } }
.gp-ok-n { margin-top: 40rpx; font-size: 56rpx; line-height: 64rpx; color: #111111; }
.gp-cod { margin-top: 48rpx; padding: 28rpx 48rpx; border-radius: 40rpx; background: #FFFFFF; display: flex; flex-direction: column; align-items: center; }
.gp-cod-l { font-size: 24rpx; color: #7A7A76; }
.gp-cod-v { margin-top: 8rpx; font-size: 56rpx; letter-spacing: 8rpx; color: #111111; }
.gp-acoes { display: flex; flex-direction: column; }
.gp-share, button.gp-share:not([size='mini']) { margin: 0 0 20rpx; border: none; line-height: 112rpx; }
.gp-share::after { border: none; }
.gp-copiar { margin-bottom: 20rpx; }
.gp-in-cod { font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; letter-spacing: 8rpx; }

.gp-metricas { margin: 0 40rpx; border-radius: 40rpx; background: #FFFFFF; overflow: hidden; }
.gp-m { display: flex; align-items: center; padding: 28rpx 32rpx; border-top: 2rpx solid #EEEEEA; }
.gp-m:first-child { border-top: none; }
.gp-m-tx { flex: 1; display: flex; flex-direction: column; margin-right: 24rpx; }
.gp-m-b { font-weight: 600; font-size: 30rpx; line-height: 40rpx; color: #111111; }
.gp-m-s { margin-top: 4rpx; font-size: 24rpx; line-height: 34rpx; color: #7A7A76; }
.gp-radio { width: 44rpx; height: 44rpx; border-radius: 999rpx; box-shadow: inset 0 0 0 3rpx #CFCFCA; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.gp-m.on .gp-radio { background: #111111; box-shadow: none; }
.gp-radio-in { width: 16rpx; height: 16rpx; border-radius: 999rpx; background: transparent; }
.gp-m.on .gp-radio-in { background: #FFFFFF; }

/* Duração do desafio */
.gp-datas { display: flex; padding: 4rpx 40rpx 0; }
.gp-d { flex: 1; margin-right: 16rpx; }
.gp-d:last-child { margin-right: 0; }
.gp-dv { padding: 20rpx 28rpx; border-radius: 28rpx; background: #FFFFFF; display: flex; flex-direction: column; }
.gp-dl { font-size: 22rpx; color: #7A7A76; }
.gp-dt { margin-top: 4rpx; font-weight: 600; font-size: 30rpx; color: #111111; }
.gp-prazos { margin-top: 20rpx; }
.gp-dica { display: block; padding: 12rpx 40rpx 0; font-size: 24rpx; line-height: 36rpx; color: #7A7A76; }
