/* Página "Eu" (light): quem sou → pontos (limão) → números → calendário → tipos → treinos */
.tela { min-height: 100vh; box-sizing: border-box; background: #F2F2EF; overflow-x: hidden; }

.cab { display: flex; align-items: center; padding: 24rpx 40rpx 0; }
.foto { width: 128rpx; height: 128rpx; border-radius: 999rpx; flex-shrink: 0; box-shadow: 0 0 0 6rpx #C6F432; display: flex; align-items: center; justify-content: center; color: #FFFFFF; font-weight: 600; font-size: 44rpx; }
.cab-tx { flex: 1; min-width: 0; margin-left: 28rpx; display: flex; flex-direction: column; }
.nome { font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 44rpx; line-height: 52rpx; letter-spacing: -1.4rpx; text-transform: uppercase; color: #111111; }
.sub { margin-top: 6rpx; font-size: 26rpx; color: #7A7A76; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.aj { width: 88rpx; height: 88rpx; border-radius: 999rpx; background: #FFFFFF; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.aj image { width: 44rpx; height: 44rpx; }

.pts { margin: 40rpx 40rpx 0; padding: 36rpx; border-radius: 48rpx; background: #C6F432; }
.pts-r { font-size: 26rpx; font-weight: 600; color: #3A4A10; }
.pts-num { display: flex; align-items: baseline; margin-top: 8rpx; }
.pts-n { font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 120rpx; line-height: 128rpx; letter-spacing: -5rpx; color: #111111; }
.pts-u { margin-left: 12rpx; font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 34rpx; color: #111111; }
.pts-pe { display: flex; margin-top: 24rpx; padding-top: 24rpx; border-top: 2rpx solid rgba(17,17,17,.12); }
.pts-i { flex: 1; display: flex; flex-direction: column; }
.pts-v { font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 40rpx; line-height: 48rpx; color: #111111; }
.pts-l { margin-top: 2rpx; font-size: 22rpx; color: #3A4A10; }

.grade { display: flex; flex-wrap: wrap; justify-content: space-between; margin: 20rpx 40rpx 0; }
.n { width: 325rpx; margin-bottom: 20rpx; padding: 28rpx 32rpx; box-sizing: border-box; border-radius: 40rpx; background: #FFFFFF; display: flex; flex-direction: column; }
.n-r { font-size: 24rpx; font-weight: 500; color: #7A7A76; }
.n-num { display: flex; align-items: baseline; margin-top: 16rpx; }
.n-v { font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 56rpx; line-height: 64rpx; letter-spacing: -2rpx; color: #111111; }
.n-u { margin-left: 8rpx; font-size: 24rpx; color: #7A7A76; }
.tps { display: block; margin: 4rpx 40rpx 0; font-size: 24rpx; color: #7A7A76; text-align: center; }

.sec-cab { display: flex; align-items: baseline; justify-content: space-between; margin: 56rpx 40rpx 20rpx; }
.sec-t { font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 36rpx; letter-spacing: -1rpx; color: #111111; }
.sec-s { font-size: 26rpx; color: #7A7A76; }

/* Calendário: 5 semanas × 7 dias */
.cal { margin: 0 40rpx; padding: 28rpx 24rpx; border-radius: 40rpx; background: #FFFFFF; }
.cal-cab { display: flex; }
.cal-cab text { flex: 1; text-align: center; font-size: 22rpx; font-weight: 600; color: #A5A5A0; }
.cal-grade { display: flex; flex-wrap: wrap; margin-top: 12rpx; }
.cal-d { width: 14.28%; height: 84rpx; display: flex; align-items: center; justify-content: center; }
.cal-d text { width: 64rpx; height: 64rpx; border-radius: 999rpx; display: flex; align-items: center; justify-content: center; font-size: 24rpx; font-weight: 600; color: #6A6A66; }
.cal-d.ok text { background: #111111; color: #FFFFFF; }
.cal-d.forte text { background: #C6F432; color: #111111; }
.cal-d.fut text { color: #D6D6D2; }
.cal-d.hoje text { box-shadow: 0 0 0 3rpx #FFFFFF, 0 0 0 6rpx #111111; }
.cal-leg { display: flex; justify-content: center; margin-top: 16rpx; }
.cal-leg-i { display: flex; align-items: center; margin: 0 16rpx; font-size: 22rpx; color: #7A7A76; }
.cal-p { width: 20rpx; height: 20rpx; border-radius: 999rpx; margin-right: 8rpx; }
.cal-p.ok { background: #111111; }
.cal-p.forte { background: #C6F432; }

.caixa { margin: 0 40rpx; padding: 8rpx 0; border-radius: 40rpx; background: #FFFFFF; }
.tipos { padding: 16rpx 32rpx 24rpx; }
.tp-l { padding: 16rpx 0; }
.tp-top { display: flex; justify-content: space-between; }
.tp-n { font-weight: 600; font-size: 28rpx; color: #111111; }
.tp-m { font-size: 24rpx; color: #7A7A76; }
.tp-trilho { margin-top: 12rpx; height: 14rpx; border-radius: 999rpx; background: #EDEDEA; overflow: hidden; }
.tp-barra { height: 100%; border-radius: 999rpx; background: #111111; }

.tr { display: flex; align-items: center; padding: 20rpx 20rpx 20rpx 24rpx; border-top: 2rpx solid #EEEEEA; }
.tr:first-child { border-top: none; }
.tr-foto { width: 96rpx; height: 96rpx; border-radius: 24rpx; flex-shrink: 0; background: #EDEDEA; }
.tr-foto.sem { display: flex; align-items: center; justify-content: center; background: #FC4C02; color: #FFFFFF; font-weight: 800; font-size: 36rpx; }
.tr-tx { flex: 1; min-width: 0; margin-left: 20rpx; display: flex; flex-direction: column; }
.tr-cab { display: flex; align-items: baseline; }
.tr-b { flex: 1; min-width: 0; font-weight: 600; font-size: 30rpx; line-height: 38rpx; color: #111111; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.tr-d { flex-shrink: 0; margin-left: 16rpx; font-size: 22rpx; line-height: 30rpx; color: #9A9A95; }
.tr-s { margin-top: 6rpx; font-size: 26rpx; line-height: 34rpx; font-weight: 500; color: #3A3A36; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.tr-tag { align-self: flex-start; margin-top: 8rpx; padding: 4rpx 14rpx; border-radius: 999rpx; box-shadow: inset 0 0 0 2rpx #CFCFCA; font-size: 20rpx; font-weight: 600; color: #6A6A66; }
.tr-lixo { width: 72rpx; height: 72rpx; border-radius: 999rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.tr-lixo image { width: 38rpx; height: 38rpx; }

.vazio { display: flex; align-items: center; justify-content: space-between; margin: 0 40rpx; padding: 24rpx 28rpx; border-radius: 32rpx; background: #FFFFFF; }
.vazio-t { font-size: 26rpx; color: #7A7A76; }
.mini-btn { height: 68rpx; line-height: 68rpx; padding: 0 28rpx; border-radius: 999rpx; background: #111111; color: #FFFFFF; font-weight: 600; font-size: 26rpx; }
.tp-press { opacity: .6; }

.estado { display: flex; flex-direction: column; align-items: center; padding: 160rpx 56rpx; text-align: center; }
.estado-tx { font-size: 28rpx; line-height: 40rpx; color: #7A7A76; }
.estado-btn { margin-top: 48rpx; width: 100%; }
.spinner { width: 56rpx; height: 56rpx; border-radius: 999rpx; border: 6rpx solid #E6E6E2; border-top-color: #111111; animation: gira .8s linear infinite; }
@keyframes gira { to { transform: rotate(360deg); } }

/* Troféus */
.tf-card { margin: 20rpx 40rpx 0; padding: 32rpx; border-radius: 48rpx; background: #111111; }
.tf-topo { display: flex; align-items: center; }
.tf-emoji { font-size: 88rpx; }
.tf-tx { display: flex; align-items: baseline; margin-left: 20rpx; }
.tf-n { font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 80rpx; line-height: 88rpx; color: #C6F432; }
.tf-l { margin-left: 12rpx; font-size: 28rpx; font-weight: 600; color: #FFFFFF; }
.tf-lista { margin-top: 20rpx; }
.tf-i { display: flex; justify-content: space-between; padding: 16rpx 0; border-top: 2rpx solid rgba(255,255,255,.1); }
.tf-i-b { font-weight: 600; font-size: 26rpx; color: #FFFFFF; }
.tf-i-s { font-size: 24rpx; color: rgba(255,255,255,.6); }
.ver-st { align-self: flex-start; margin-top: 6rpx; font-weight: 700; font-size: 24rpx; color: #FC5200; }
.pw-st { display: block; width: 274rpx; height: 28rpx; margin: 24rpx auto 0; }

.nome-l { display: flex; align-items: center; }
.selo { width: 36rpx; height: 36rpx; margin-left: 10rpx; flex-shrink: 0; }

/* Meu nível (só no meu perfil): card escuro com o selo da faixa */
.nvc { position: relative; margin: 32rpx 40rpx 0; padding: 32rpx 36rpx 32rpx 28rpx; border-radius: 40rpx; background: #111111; color: #FFFFFF; overflow: hidden; }
.nvc-luz { position: absolute; left: -60rpx; top: -80rpx; width: 360rpx; height: 360rpx; border-radius: 999rpx; }
.nvc-topo { position: relative; display: flex; align-items: center; }
.nvc-share { position: absolute; right: 12rpx; top: 12rpx; z-index: 2; width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; }
.nvc-share image { width: 44rpx; height: 44rpx; }
.nvc-selo { position: relative; width: 176rpx; height: 202rpx; flex-shrink: 0; }
.nvc-selo image { width: 100%; height: 100%; display: block; }
.nvc-n { position: absolute; left: 0; right: 0; top: 44%; margin-top: -45rpx; height: 90rpx; line-height: 90rpx; text-align: center; white-space: nowrap; font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; color: #121212; text-shadow: 0 2rpx 0 rgba(255,255,255,.45); }
.nvc-tx { flex: 1; margin-left: 24rpx; display: flex; flex-direction: column; align-items: flex-start; min-width: 0; }
.nvc-l { font-size: 22rpx; font-weight: 600; letter-spacing: 4rpx; text-transform: uppercase; color: rgba(255,255,255,.55); }
.nvc-faixa { margin-top: 8rpx; font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 44rpx; line-height: 52rpx; letter-spacing: -1rpx; }
.nvc-xp { margin-top: 8rpx; font-size: 24rpx; color: rgba(255,255,255,.6); }
.nvc-barra { position: relative; height: 14rpx; margin-top: 24rpx; border-radius: 999rpx; overflow: hidden; background: rgba(255,255,255,.12); }
.nvc-in { height: 100%; border-radius: 999rpx; }
.nvc-falta { position: relative; display: block; margin-top: 14rpx; font-size: 26rpx; font-weight: 500; color: rgba(255,255,255,.8); }

/* Nível e faixa embaixo do nome: selo pequeno + texto */
.cab-nv { display: flex; align-items: center; margin-top: 10rpx; }
.cab-nv-selo { width: 40rpx; height: 46rpx; margin-right: 10rpx; flex-shrink: 0; }
.cab-nv-n { font-weight: 600; font-size: 26rpx; color: #111111; }

/* Conquistas: faixa rolável de badges; bloqueadas em cinza com quando dá pra ganhar */
.cq { margin-top: 40rpx; }
.cq-cab { display: flex; align-items: center; padding: 0 40rpx; }
.cq-t { font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 34rpx; letter-spacing: -1rpx; color: #111111; }
.cq-n { margin-left: 14rpx; min-width: 44rpx; height: 44rpx; padding: 0 12rpx; box-sizing: border-box; border-radius: 999rpx; background: #111111; color: #C6F432; font-weight: 700; font-size: 24rpx; display: flex; align-items: center; justify-content: center; }
.cq-lista { display: flex; flex-direction: row; white-space: nowrap; margin-top: 20rpx; padding: 0 28rpx; box-sizing: border-box; width: 100%; }
.cq-i { position: relative; display: inline-flex; flex-direction: column; align-items: center; width: 212rpx; margin: 0 12rpx; padding: 24rpx 12rpx 22rpx; box-sizing: border-box; border-radius: 36rpx; background: #111111; overflow: hidden; flex-shrink: 0; vertical-align: top; }
.cq-luz { position: absolute; left: -20rpx; top: -20rpx; width: 252rpx; height: 252rpx; border-radius: 999rpx; }
.cq-img { position: relative; width: 150rpx; height: 172rpx; }
.cq-nome { position: relative; margin-top: 14rpx; max-width: 100%; white-space: normal; text-align: center; font-weight: 700; font-size: 24rpx; line-height: 30rpx; color: #FFFFFF; }
.cq-s { position: relative; margin-top: 6rpx; font-size: 21rpx; color: rgba(255,255,255,.55); }
.cq-i.bloq { background: #E9E9E5; }
.cq-i.bloq .cq-img { opacity: .35; filter: grayscale(1); }
.cq-i.bloq .cq-nome { color: #55554F; }
.cq-falta { font-weight: 700; }
