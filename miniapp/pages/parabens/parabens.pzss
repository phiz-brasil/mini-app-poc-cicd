.pb { min-height: 100vh; position: relative; overflow: hidden; color: #111111; background: #C6F432; }

.confete { position: absolute; left: 0; right: 0; top: 0; height: 100vh; pointer-events: none; z-index: 1; }
.cf { position: absolute; top: -40rpx; border-radius: 4rpx; opacity: 0; animation-name: cai; animation-timing-function: cubic-bezier(.3,.6,.5,1); animation-fill-mode: forwards; }
@keyframes cai { 0% { opacity: 1; transform: translateY(0) rotate(0deg); } 85% { opacity: 1; } 100% { opacity: 0; transform: translateY(78vh) rotate(540deg); } }

.pb-topo { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; text-align: center; padding: 0 56rpx 80rpx; }
.pb-selo { width: 176rpx; height: 176rpx; border-radius: 54rpx; background: #111111; display: flex; align-items: center; justify-content: center; box-shadow: 0 32rpx 72rpx rgba(17,17,17,.25); animation: selo .7s cubic-bezier(.2,1.6,.4,1) both; }
.pb-selo image { width: 104rpx; height: 104rpx; }
@keyframes selo { from { transform: scale(.3) rotate(-14deg); opacity: 0; } }
.pb-tit { margin-top: 44rpx; font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 64rpx; line-height: 74rpx; letter-spacing: -2rpx; animation: sobe .5s .25s both; }
.pb-sub { margin-top: 16rpx; font-size: 34rpx; line-height: 46rpx; color: #2B3A0A; animation: sobe .5s .35s both; }
@keyframes sobe { from { transform: translateY(24rpx); opacity: 0; } }
.pb-pills { display: flex; flex-wrap: wrap; justify-content: center; margin-top: 32rpx; animation: sobe .5s .45s both; }
.pill { height: 64rpx; line-height: 64rpx; padding: 0 26rpx; margin: 8rpx; border-radius: 999rpx; background: #111111; color: #FFFFFF; font-size: 26rpx; font-weight: 600; }

.pb-folha { position: relative; z-index: 3; min-height: 50vh; padding: 48rpx 40rpx 64rpx; border-radius: 56rpx 56rpx 0 0; background: #F2F2EF; color: #111111; animation: folha .5s .5s cubic-bezier(.2,1,.3,1) both; }
@keyframes folha { from { transform: translateY(120rpx); opacity: 0; } }
.pb-q { display: block; font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 40rpx; letter-spacing: -1.2rpx; text-transform: uppercase; }

/* Prévia do Momento: igual à arte do servidor (foto cheia, degradê, selo) */
.mom { position: relative; height: 520rpx; margin-top: 28rpx; border-radius: 40rpx; overflow: hidden; background: #111111; }
.mom-img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.mom-grad { position: absolute; left: 0; right: 0; bottom: 0; height: 70%; background: linear-gradient(180deg, rgba(0,0,0,0), rgba(0,0,0,.85)); }
.mom-logo { position: absolute; left: 28rpx; top: 24rpx; font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 26rpx; color: #FFFFFF; }
.mom-selo { position: absolute; right: 28rpx; top: 150rpx; width: 128rpx; height: 128rpx; border-radius: 999rpx; background: #C6F432; border: 4rpx solid #111111; transform: rotate(-14deg); display: flex; flex-direction: column; align-items: center; justify-content: center; }
.mom-selo text { font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 22rpx; line-height: 24rpx; color: #111111; }
.mom-pe { position: absolute; left: 28rpx; right: 28rpx; bottom: 24rpx; display: flex; flex-direction: column; }
.mom-r { font-size: 20rpx; font-weight: 700; letter-spacing: 2rpx; text-transform: uppercase; color: #C6F432; }
.mom-num { display: flex; align-items: flex-end; margin-top: 4rpx; }
.mom-n { font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 88rpx; line-height: 88rpx; letter-spacing: -3rpx; color: #FFFFFF; }
.mom-u { margin: 0 0 10rpx 10rpx; font-size: 26rpx; font-weight: 700; color: rgba(255,255,255,.72); }

.pb-folha .btn { margin-top: 36rpx; }
.pb-nao { height: 88rpx; display: flex; align-items: center; justify-content: center; margin-top: 8rpx; font-weight: 600; font-size: 30rpx; color: #7A7A76; }
.pb-res { display: block; margin-top: 36rpx; padding: 28rpx 32rpx; border-radius: 28rpx; background: #FFFFFF; font-size: 30rpx; line-height: 42rpx; text-align: center; }
