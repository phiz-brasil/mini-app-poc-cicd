/* Moments (light, com vidro no header e no visualizador) */
.tela { min-height: 100vh; box-sizing: border-box; background: #F2F2EF; overflow-x: hidden; }

.hd { position: fixed; left: 0; right: 0; top: 0; z-index: 50; display: flex; align-items: center; justify-content: center; padding-bottom: 10px; }
/* Vidro do header: camada atrás do conteúdo, sem fio embaixo. O blur e o fundo somem aos poucos
   (máscara em degradê), então não aparece a divisão — como no iOS. */
.hd-vidro { position: absolute; left: 0; right: 0; top: 0; bottom: -28px; z-index: -1; opacity: 0; transition: opacity .3s;
  background: linear-gradient(180deg, rgba(242,242,239,.86) 0%, rgba(242,242,239,.6) 62%, rgba(242,242,239,0) 100%);
  -webkit-backdrop-filter: saturate(180%) blur(22px); backdrop-filter: saturate(180%) blur(22px);
  -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 58%, rgba(0,0,0,0) 100%); mask-image: linear-gradient(180deg, #000 0%, #000 58%, rgba(0,0,0,0) 100%); }
.hd.vidro .hd-vidro { opacity: 1; }
.hd-btn { position: absolute; left: 14px; bottom: 10px; border-radius: 999px; background: rgba(255,255,255,.85); box-shadow: 0 4rpx 20rpx rgba(17,17,17,.08), inset 0 0 0 1rpx rgba(17,17,17,.06); display: flex; align-items: center; justify-content: center; }
.hd-btn image { width: 18px; height: 18px; }
.hd-logo { height: 22px; }
.tp-press { opacity: .6; }

.titulo { display: block; padding: 0 40rpx; font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 64rpx; letter-spacing: -2rpx; text-transform: uppercase; color: #111111; }

.hero { position: relative; overflow: hidden; margin: 32rpx 40rpx 0; padding: 48rpx 40rpx; border-radius: 48rpx; background: linear-gradient(150deg, #1B1530 0%, #2A1660 55%, #8B5CF6 100%); box-shadow: 0 30rpx 70rpx rgba(42,22,96,.35); }
.hero-luz { position: absolute; right: -160rpx; top: -200rpx; width: 600rpx; height: 600rpx; border-radius: 999rpx; background: radial-gradient(circle, rgba(198,244,50,.45) 0%, rgba(198,244,50,0) 62%); }
.hero-ic { position: relative; width: 104rpx; height: 104rpx; border-radius: 32rpx; background: #C6F432; display: flex; align-items: center; justify-content: center; box-shadow: 0 16rpx 40rpx rgba(0,0,0,.3); }
.hero-ic image { width: 52rpx; height: 52rpx; }
.hero-t { position: relative; display: block; margin-top: 40rpx; font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 44rpx; line-height: 52rpx; letter-spacing: -1.2rpx; color: #FFFFFF; }
.hero-s { position: relative; display: block; margin-top: 8rpx; font-size: 26rpx; color: rgba(255,255,255,.7); }

.frames { margin: 32rpx 40rpx 0; }
.fr-grande { display: block; width: 100%; height: 838rpx; border-radius: 40rpx; background: #E4E4E0; box-shadow: 0 30rpx 70rpx rgba(17,17,17,.18); }
.fr-op { display: flex; margin: 24rpx -8rpx 0; }
.fr-mini { flex: 1; margin: 0 8rpx; display: flex; flex-direction: column; align-items: center; }
.fr-mini image { width: 100%; height: 260rpx; border-radius: 24rpx; box-shadow: inset 0 0 0 0 transparent; opacity: .55; transition: opacity .2s; }
.fr-mini.on image { opacity: 1; box-shadow: 0 0 0 5rpx #111111; }
.fr-mini text { margin-top: 10rpx; font-size: 24rpx; font-weight: 600; color: #7A7A76; }
.fr-mini.on text { color: #111111; }
.frames .btn { margin-top: 28rpx; }
.link { margin-top: 8rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 28rpx; color: #7A7A76; }

.trilho { display: flex; flex-direction: row; white-space: nowrap; width: 100%; }
.pc { display: inline-flex; flex-direction: column; width: 280rpx; margin-right: 20rpx; flex-shrink: 0; }
.trilho .pc:first-child { margin-left: 40rpx; }
.trilho .pc:last-child { margin-right: 40rpx; }
.pc image { width: 280rpx; height: 350rpx; border-radius: 28rpx; background: #E4E4E0; box-shadow: 0 16rpx 36rpx rgba(17,17,17,.12); }
.pc-t { margin-top: 14rpx; font-weight: 600; font-size: 26rpx; color: #111111; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pc-s { margin-top: 2rpx; font-size: 22rpx; color: #7A7A76; }

.vazio { margin: 40rpx; padding: 32rpx; border-radius: 32rpx; background: #FFFFFF; font-size: 26rpx; line-height: 38rpx; color: #7A7A76; text-align: center; }

.vw { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 60; display: flex; align-items: flex-end; }
.vw-fundo { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background: rgba(17,17,17,.45); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); animation: vw-in .2s both; }
.vw-card { position: relative; width: 100%; box-sizing: border-box; padding: 20rpx 40rpx 64rpx; border-radius: 56rpx 56rpx 0 0; background: rgba(242,242,239,.92); -webkit-backdrop-filter: saturate(180%) blur(24px); backdrop-filter: saturate(180%) blur(24px); animation: vw-sobe .4s cubic-bezier(.2,1.2,.4,1) both; }
.vw-alca { width: 72rpx; height: 10rpx; margin: 0 auto 24rpx; border-radius: 999rpx; background: #D6D6D2; }
.vw-t { display: block; font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 34rpx; line-height: 42rpx; letter-spacing: -.8rpx; color: #111111; text-align: center; }
.vw-s { display: block; margin-top: 6rpx; font-size: 24rpx; color: #7A7A76; text-align: center; }
.vw-img { display: block; width: 100%; height: 760rpx; margin-top: 20rpx; border-radius: 36rpx; }
.vw-post { margin-top: 28rpx; }
.vw-dois { display: flex; margin: 16rpx -6rpx 0; }
.vw-sec, button.vw-sec:not([size='mini']) { flex: 1; height: 96rpx; line-height: 96rpx; margin: 0 6rpx; padding: 0; border-radius: 999rpx; background: #FFFFFF; box-shadow: inset 0 0 0 2rpx #E2E2DE; color: #111111; font-weight: 600; font-size: 28rpx; text-align: center; border: none; }
.vw-sec::after { border: none; }
@keyframes vw-in { from { opacity: 0; } }
@keyframes vw-sobe { from { transform: translateY(100%); } }

.vw-ok { margin-top: 24rpx; padding: 24rpx 28rpx; border-radius: 32rpx; background: #C6F432; }
.vw-ok-b { display: block; font-weight: 700; font-size: 30rpx; color: #111111; }
.vw-ok-s { display: block; margin-top: 6rpx; font-size: 26rpx; line-height: 36rpx; color: #3A4A10; }
