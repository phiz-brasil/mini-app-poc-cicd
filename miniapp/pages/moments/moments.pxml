<view class="tela">
  <!-- Header de vidro: voltar à esquerda, logo no centro -->
  <view class="hd {{rolou ? 'vidro' : ''}}" style="padding-top: {{barTop}}px; height: {{barH}}px">
    <view class="hd-vidro"></view>
    <view class="hd-btn" style="width: {{barH}}px; height: {{barH}}px" bindtap="voltar" hover-class="tp-press"><image src="{{ic.VOLTAR}}" mode="aspectFit"></image></view>
    <image class="hd-logo" src="/images/logo-claro.png" mode="heightFix"></image>
  </view>

  <view style="height: {{barTop + barH + 24}}px"></view>
  <text class="titulo">Moments</text>

  <!-- Foto com moldura -->
  <view class="hero" wx:if="{{!fr}}" bindtap="tirarFoto" hover-class="btn-press">
    <view class="hero-luz"></view>
    <view class="hero-ic"><image src="{{ic.CAMERA_PRETA}}" mode="aspectFit"></image></view>
    <text class="hero-t">{{montando ? "Montando as molduras…" : "Tirar foto com moldura"}}</text>
    <text class="hero-s">Selo, faixa ou borda do Tá Pago!</text>
  </view>

  <view class="frames" wx:else>
    <image class="fr-grande" src="{{fr.frames[fr.sel].arte}}" mode="aspectFit"></image>
    <view class="fr-op">
      <view wx:for="{{fr.frames}}" wx:key="frame" class="fr-mini {{fr.sel === index ? 'on' : ''}}" data-i="{{index}}" bindtap="escolherFrame">
        <image src="{{item.arte}}" mode="aspectFill"></image>
        <text>{{item.nome}}</text>
      </view>
    </view>
    <view class="btn" bindtap="usarFrame" hover-class="btn-press">Usar essa moldura</view>
    <view class="link" bindtap="tirarFoto">Tirar outra foto</view>
  </view>

  <!-- Seus treinos -->
  <block wx:if="{{treinos.length}}">
    <text class="sec">Seus treinos</text>
    <scroll-view class="trilho" scroll-x enable-flex>
      <view wx:for="{{treinos}}" wx:key="id" class="pc" data-i="{{index}}" bindtap="abrirTreino" hover-class="btn-press">
        <image src="{{item.arte}}" mode="aspectFill" lazy-load></image>
        <text class="pc-t">{{item.titulo}}</text><text class="pc-s">{{item.quando}} · {{item.min}} min</text>
      </view>
    </scroll-view>
  </block>

  <!-- Pódios da semana -->
  <block wx:if="{{podios.length}}">
    <text class="sec">Pódio da semana</text>
    <scroll-view class="trilho" scroll-x enable-flex>
      <view wx:for="{{podios}}" wx:key="chave" class="pc" data-i="{{index}}" bindtap="abrirPodio" hover-class="btn-press">
        <image src="{{item.arte}}" mode="aspectFill" lazy-load></image>
        <text class="pc-t">{{item.titulo}}</text>
      </view>
    </scroll-view>
  </block>

  <!-- Troféus -->
  <block wx:if="{{campeoes.length}}">
    <text class="sec">Seus troféus</text>
    <scroll-view class="trilho" scroll-x enable-flex>
      <view wx:for="{{campeoes}}" wx:key="id" class="pc" data-i="{{index}}" bindtap="abrirCampeao" hover-class="btn-press">
        <image src="{{item.arte}}" mode="aspectFill" lazy-load></image>
        <text class="pc-t">{{item.titulo}}</text>
      </view>
    </scroll-view>
  </block>

  <view class="vazio" wx:if="{{!carregando && !treinos.length && !podios.length}}">
    <text>Quando você registrar treinos, as artes deles aparecem aqui prontas pra postar.</text>
  </view>
  <view style="height: 120rpx"></view>

  <!-- Visualizador: postar, salvar, mandar no chat -->
  <view class="vw" wx:if="{{ver}}" catchtouchmove="nada">
    <view class="vw-fundo" bindtap="fechar"></view>
    <view class="vw-card">
      <view class="vw-alca"></view>
      <text class="vw-t">{{ver.titulo}}</text>
      <text class="vw-s">Pronta pra postar no seu Moments</text>
      <image class="vw-img" src="{{ver.arte}}" mode="aspectFit"></image>
      <view class="vw-ok" wx:if="{{feito === 'salvo'}}">
        <text class="vw-ok-b">✓ Salva na sua galeria</text>
        <text class="vw-ok-s">Agora abre o Moments no PhizChat, toca em postar e escolhe essa imagem.</text>
      </view>
      <view class="vw-ok" wx:elif="{{feito === 'aberto'}}">
        <text class="vw-ok-b">Segura a imagem pra salvar</text>
        <text class="vw-ok-s">Depois é só postar no seu Moments pelo PhizChat.</text>
      </view>
      <view class="btn vw-post" wx:if="{{feito !== 'salvo'}}" bindtap="postar" hover-class="btn-press">{{ocupado === 'post' ? "Salvando…" : "Salvar pra postar no Moments"}}</view>
      <view class="vw-dois">
        <button class="vw-sec" open-type="share">Mandar no chat</button>
      </view>
    </view>
  </view>

  <view class="toast" style="bottom: 64rpx" wx:if="{{toast}}">{{toast}}</view>
</view>
