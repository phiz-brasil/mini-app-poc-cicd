/* Home (light) — tudo no mesmo ritmo:
   margem lateral 40rpx · vão entre cartões 20rpx · entre seções 56rpx
   cartão branco, raio 40rpx, respiro 32rpx · ação em preto · limão só no cartão do dia */
.tela { min-height: 100vh; box-sizing: border-box; background: #F2F2EF; padding-bottom: 20rpx; overflow-x: hidden; }

/* Header fixo de vidro (estilo Apple) */
.hd { position: fixed; left: 0; right: 0; top: 0; z-index: 50; display: flex; align-items: center; justify-content: center; padding-bottom: 10px; }
/* Vidro do header: camada atrás do conteúdo, sem fio embaixo. O blur e o fundo somem aos poucos
   (máscara em degradê), então não aparece a divisão — como no iOS. */
.hd-vidro { position: absolute; left: 0; right: 0; top: 0; bottom: -28px; z-index: -1; opacity: 0; transition: opacity .3s;
  background: linear-gradient(180deg, rgba(242,242,239,.86) 0%, rgba(242,242,239,.6) 62%, rgba(242,242,239,0) 100%);
  -webkit-backdrop-filter: saturate(180%) blur(22px); backdrop-filter: saturate(180%) blur(22px);
  -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 58%, rgba(0,0,0,0) 100%); mask-image: linear-gradient(180deg, #000 0%, #000 58%, rgba(0,0,0,0) 100%); }
.hd.vidro .hd-vidro { opacity: 1; }
.hd-mais { position: absolute; left: 14px; bottom: 10px; border-radius: 999px; background: rgba(255,255,255,.85); box-shadow: 0 4rpx 20rpx rgba(17,17,17,.08), inset 0 0 0 1rpx rgba(17,17,17,.06);
  display: flex; align-items: center; justify-content: center; transition: transform .25s cubic-bezier(.2,1.4,.4,1), background .2s; }
.hd-mais image { width: 18px; height: 18px; }
.hd-mais.on { transform: rotate(45deg); background: #C6F432; }
.hd-logo { height: 22px; }

/* Menu do + */
.mn { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 70; }
.mn-fundo { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background: rgba(17,17,17,.08); animation: fl-in .2s both; }
.mn-card { position: absolute; left: 14px; width: 560rpx; padding: 12rpx; border-radius: 40rpx; background: rgba(255,255,255,.82);
  -webkit-backdrop-filter: saturate(180%) blur(24px); backdrop-filter: saturate(180%) blur(24px);
  box-shadow: 0 30rpx 80rpx rgba(17,17,17,.18), 0 2rpx 8rpx rgba(17,17,17,.06), inset 0 0 0 1rpx rgba(255,255,255,.6);
  transform-origin: 0 0; animation: mn-abre .32s cubic-bezier(.2,1.3,.4,1) both; }
@keyframes mn-abre { from { transform: scale(.6); opacity: 0; } }
.mn-i { display: flex; align-items: center; padding: 20rpx 20rpx; border-radius: 30rpx; }
.mn-press { background: rgba(17,17,17,.05); }
.mn-ic { width: 84rpx; height: 84rpx; border-radius: 26rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.mn-ic image { width: 44rpx; height: 44rpx; }
.mn-ic.limao { background: #C6F432; }
.mn-ic.violeta { background: linear-gradient(135deg, #A78BFA, #8B5CF6); }
.mn-ic.preto { background: #111111; }
.mn-ic.cinza { background: #E4E4E0; }
.mn-tx { margin-left: 22rpx; display: flex; flex-direction: column; }
.mn-b { font-weight: 600; font-size: 30rpx; color: #111111; }
.mn-s { margin-top: 2rpx; font-size: 24rpx; color: #7A7A76; }
.mn-l { height: 1rpx; margin: 0 20rpx; background: rgba(17,17,17,.08); }

/* Cabeçalho */
.cab { padding: 0 40rpx; }
.ola { display: flex; align-items: center; }
.ola-eu { flex: 1; min-width: 0; display: flex; align-items: center; }
.ola-av { width: 88rpx; height: 88rpx; border-radius: 999rpx; flex-shrink: 0; }
.ola-av.letra { display: flex; align-items: center; justify-content: center; color: #FFFFFF; font-weight: 600; font-size: 32rpx; }
.ola-tx { flex: 1; min-width: 0; margin-left: 20rpx; display: flex; flex-direction: column; }
.aj { width: 88rpx; height: 88rpx; border-radius: 999rpx; background: #FFFFFF; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.aj image { width: 44rpx; height: 44rpx; }
.ola-s { font-size: 26rpx; color: #7A7A76; line-height: 32rpx; }
.ola-n { font-family: "Poppins", sans-serif; font-weight: 600; font-size: 34rpx; line-height: 42rpx; color: #111111; }
.titulo { display: block; margin-top: 36rpx; font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 60rpx; line-height: 68rpx; letter-spacing: -2rpx; text-transform: uppercase; color: #111111; }

/* Filtro */
/* scroll-view sem padding (com padding ele passa da tela e a página rola de lado) */
.filtro { display: flex; flex-direction: row; white-space: nowrap; width: 100%; margin-top: 32rpx; }
.filtro .pilula:first-child { margin-left: 40rpx; }
.filtro .pilula:last-child { margin-right: 40rpx; }
.pilula { display: inline-flex; align-items: center; height: 72rpx; padding: 0 30rpx; margin-right: 12rpx; border-radius: 999rpx; background: #FFFFFF; box-shadow: 0 4rpx 14rpx rgba(17,17,17,.05); color: #3A3A38; font-size: 28rpx; font-weight: 500; flex-shrink: 0; }
.pilula.on { background: #111111; box-shadow: none; color: #FFFFFF; font-weight: 600; }
/* "+ Grupo": menor, sem fio, cinza cheio */
.pilula.novo { height: 56rpx; padding: 0 20rpx 0 14rpx; margin-left: 4rpx; align-self: center; background: #E4E4E0; box-shadow: none; color: #111111; font-size: 24rpx; font-weight: 600; }
.pilula.novo image { width: 26rpx; height: 26rpx; margin-right: 6rpx; }

/* O dia */
.dia { position: relative; margin: 32rpx 40rpx 0; border-radius: 48rpx; overflow: hidden; background: #C6F432; }
.dia-in { position: relative; padding: 36rpx; }
.dia-r { display: block; font-size: 26rpx; font-weight: 600; color: rgba(17,17,17,.62); }
.seta-b { width: 80rpx; height: 80rpx; border-radius: 999rpx; background: #111111; display: flex; align-items: center; justify-content: center; }
.seta { width: 36rpx; height: 36rpx; }
.dia-pos { display: flex; align-items: flex-end; margin-top: 28rpx; }
.dia-pos-n { font-size: 220rpx; line-height: 200rpx; letter-spacing: -10rpx; color: #111111; }
.dia-pos-l { display: flex; flex-direction: column; margin: 0 0 24rpx 16rpx; }
.dia-pos-de { margin-top: 6rpx; font-size: 26rpx; color: #3A4A10; }
.seg-sem { display: flex; margin-top: 32rpx; }
.sem-i { flex: 1; margin-right: 10rpx; display: flex; flex-direction: column; }
.sem-i:last-child { margin-right: 0; }
.sem-b { height: 12rpx; border-radius: 999rpx; background: rgba(17,17,17,.14); }
.sem-i.ok .sem-b { background: #111111; }
.sem-l { margin-top: 10rpx; font-size: 20rpx; font-weight: 600; color: rgba(17,17,17,.45); text-align: center; }
.sem-i.hoje .sem-l { color: #111111; }

/* Dois cartões */
.grade { display: flex; justify-content: space-between; margin: 20rpx 40rpx 0; }
.card { width: 325rpx; height: 260rpx; padding: 32rpx; border-radius: 40rpx; background: #FFFFFF; display: flex; flex-direction: column; box-sizing: border-box; }
.card-r { font-size: 26rpx; font-weight: 500; color: #7A7A76; }
.card-num { display: flex; align-items: baseline; margin-top: auto; }
.n-grande { font-size: 76rpx; line-height: 84rpx; letter-spacing: -3rpx; color: #111111; }
.n-un { margin-left: 8rpx; font-size: 28rpx; color: #7A7A76; }
.card-s { margin-top: 6rpx; font-size: 22rpx; color: #7A7A76; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.card.novo { background: #111111; justify-content: space-between; }
.novo-mais { width: 88rpx; height: 88rpx; border-radius: 999rpx; background: #C6F432; display: flex; align-items: center; justify-content: center; }
.novo-mais image { width: 44rpx; height: 44rpx; }
.novo-t { font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 34rpx; line-height: 42rpx; letter-spacing: -1rpx; color: #FFFFFF; }

/* Grupo escolhido */
.grupo { display: flex; align-items: center; margin: 20rpx 40rpx 0; padding: 24rpx 24rpx 24rpx 32rpx; border-radius: 40rpx; background: #FFFFFF; }
.grupo-tx { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.grupo-n { font-weight: 600; font-size: 30rpx; color: #111111; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.grupo-s { margin-top: 2rpx; font-size: 24rpx; color: #7A7A76; }
.mini-btn, button.mini-btn:not([size='mini']) { margin: 0 0 0 12rpx; height: 68rpx; line-height: 68rpx; padding: 0 28rpx; border-radius: 999rpx; background: #111111; color: #FFFFFF; font-weight: 600; font-size: 26rpx; border: none; flex-shrink: 0; }
.mini-btn::after { border: none; }
.mini-btn.esc, button.mini-btn.esc:not([size='mini']) { background: #EDEDEA; color: #111111; }

/* Ranking */
.sec-cab { display: flex; align-items: center; justify-content: space-between; margin: 56rpx 40rpx 20rpx; }
.sec-t { font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 38rpx; letter-spacing: -1rpx; color: #111111; }
.seg { display: flex; padding: 6rpx; border-radius: 999rpx; background: #E9E9E5; }
.seg-i { width: 128rpx; justify-content: center; height: 60rpx; padding: 0; border-radius: 999rpx; display: flex; align-items: center; font-size: 26rpx; font-weight: 500; color: #7A7A76; }
.seg .seg-th { width: 128rpx; }
.seg-i.on { background: #FFFFFF; color: #111111; font-weight: 600; box-shadow: 0 2rpx 8rpx rgba(17,17,17,.08); }

.caixa { margin: 0 40rpx; padding: 8rpx 0; border-radius: 40rpx; background: #FFFFFF; }
.linha { display: flex; align-items: center; height: 128rpx; padding: 0 28rpx; border-top: 2rpx solid #EEEEEA; }
.linha:first-child { border-top: none; }
.linha.eu { background: #F7F7F4; }
.pos { width: 44rpx; font-weight: 600; font-size: 28rpx; color: #A5A5A0; }
.pos.lider { color: #111111; }
.av { width: 80rpx; height: 80rpx; font-size: 28rpx; color: #FFFFFF; }
.tx { flex: 1; min-width: 0; margin-left: 20rpx; display: flex; flex-direction: column; }
.tx-b { font-weight: 600; font-size: 30rpx; line-height: 38rpx; color: #111111; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.tx-s { font-size: 24rpx; line-height: 32rpx; color: #7A7A76; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.foto { width: 64rpx; height: 64rpx; margin-left: 12rpx; border-radius: 16rpx; flex-shrink: 0; }
.min { margin-left: 16rpx; font-weight: 600; font-size: 30rpx; color: #111111; white-space: nowrap; }
.min-u { font-weight: 400; font-size: 22rpx; color: #7A7A76; }
.tp { width: 64rpx; height: 64rpx; margin-left: 16rpx; border-radius: 999rpx; background: #EDEDEA; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.tp image { width: 30rpx; height: 30rpx; }
.tp.on { background: #C6F432; }
.tp-press { opacity: .7; }

.vazio { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 28rpx; border-bottom: 2rpx solid #EEEEEA; }
.vazio-t { font-size: 26rpx; color: #7A7A76; }

.regra { display: block; margin: 24rpx 40rpx 0; font-size: 24rpx; line-height: 34rpx; color: #A5A5A0; text-align: center; }
.rodape-links { display: flex; justify-content: center; margin-top: 32rpx; }
.link { font-size: 26rpx; color: #7A7A76; padding: 16rpx 24rpx; }

.estado { display: flex; flex-direction: column; align-items: center; padding: 120rpx 56rpx; text-align: center; }
.titulo-p { font-family: "Poppins", sans-serif; font-weight: 600; font-size: 40rpx; color: #111111; }
.estado-tx { margin-top: 16rpx; font-size: 28rpx; line-height: 40rpx; color: #7A7A76; }
.estado-btn { margin-top: 48rpx; width: 100%; }
.spinner { width: 56rpx; height: 56rpx; border-radius: 999rpx; border: 6rpx solid #E6E6E2; border-top-color: #111111; animation: gira .8s linear infinite; }
@keyframes gira { to { transform: rotate(360deg); } }

/* Folha "Chegou do Strava" */
.fl { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 60; display: flex; align-items: flex-end; }
.fl-fundo { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background: rgba(17,17,17,.5); animation: fl-in .2s both; }
.fl-card { position: relative; width: 100%; max-height: 92vh; overflow-y: auto; box-sizing: border-box; padding: 20rpx 40rpx 64rpx; border-radius: 56rpx 56rpx 0 0; background: #F2F2EF; animation: fl-sobe .4s cubic-bezier(.2,1.2,.4,1) both; }
.fl-alca { width: 72rpx; height: 10rpx; margin: 0 auto 28rpx; border-radius: 999rpx; background: #D6D6D2; }
.fl-de { display: flex; align-items: center; font-size: 26rpx; font-weight: 600; color: #7A7A76; }
.fl-st { width: 44rpx; height: 44rpx; margin-right: 12rpx; flex-shrink: 0; }
.fl-tit { display: block; margin-top: 16rpx; font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 52rpx; line-height: 60rpx; letter-spacing: -1.6rpx; text-transform: uppercase; color: #111111; }
.fl-l { display: block; margin-top: 8rpx; font-size: 28rpx; color: #6A6A66; }
.fl-arte { display: block; width: 100%; height: 640rpx; margin-top: 28rpx; border-radius: 40rpx; background: #E4E4DF; }
.fl-aviso { display: block; margin-top: 24rpx; font-size: 28rpx; line-height: 40rpx; color: #111111; text-align: center; }
.fl-aviso.erro { color: #E5484D; }
.fl-card .btn { margin-top: 32rpx; }
.fl-foto { margin-top: 16rpx; }
.fl-nao { height: 80rpx; margin-top: 8rpx; display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 28rpx; color: #7A7A76; }
@keyframes fl-in { from { opacity: 0; } }
@keyframes fl-sobe { from { transform: translateY(100%); } }

.stc { display: flex; align-items: center; margin: 20rpx 40rpx 0; padding: 24rpx 24rpx 24rpx 28rpx; border-radius: 40rpx; background: #FFFFFF; }
.stc-tx { flex: 1; min-width: 0; margin: 0 16rpx; display: flex; flex-direction: column; }
.stc-b { font-weight: 600; font-size: 28rpx; color: #111111; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.stc-s { margin-top: 2rpx; font-size: 24rpx; color: #7A7A76; }
.stc .fl-st { margin-right: 0; flex-shrink: 0; }

/* Abertura */
.sp { position: fixed; left: 0; right: 0; top: 0; bottom: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #F2F2EF; }
.sp-sim { position: relative; width: 200rpx; height: 200rpx; border-radius: 60rpx; background: #C6F432; animation: sp-pula .7s cubic-bezier(.2,1.6,.4,1) both, sp-respira 2.4s 1s ease-in-out infinite; }
.sp-check { position: absolute; left: 0; top: 0; height: 200rpx; width: 0; overflow: hidden; animation: sp-traco .6s .45s cubic-bezier(.6,0,.3,1) forwards; }
.sp-check image { width: 200rpx; height: 200rpx; }
.sp-logo { height: 64rpx; margin-top: 56rpx; animation: sp-sobe .5s .8s both; }
.sp-frase { margin-top: 28rpx; font-size: 28rpx; color: #7A7A76; animation: sp-sobe .5s 1s both; }
.sp-barra { position: relative; width: 240rpx; height: 8rpx; margin-top: 40rpx; border-radius: 999rpx; background: #E4E4E0; overflow: hidden; animation: sp-sobe .5s 1.1s both; }
.sp-barra-in { position: absolute; top: 0; left: -40%; width: 40%; height: 100%; border-radius: 999rpx; background: #111111; animation: sp-corre 1.2s ease-in-out infinite; }
@keyframes sp-pula { from { transform: scale(.3) rotate(-18deg); opacity: 0; } }
@keyframes sp-traco { to { width: 200rpx; } }
@keyframes sp-respira { 50% { transform: scale(1.05); } }
@keyframes sp-sobe { from { transform: translateY(20rpx); opacity: 0; } }
@keyframes sp-corre { to { left: 100%; } }

/* Selo verificado (azul) e cutucada */
.tx-l { display: flex; align-items: center; min-width: 0; }
.selo { width: 30rpx; height: 30rpx; margin-left: 8rpx; flex-shrink: 0; }
.cut { height: 60rpx; margin-left: 16rpx; padding: 0 20rpx; border-radius: 999rpx; box-shadow: inset 0 0 0 2rpx #111111; display: flex; align-items: center; flex-shrink: 0; }
.cut text { font-size: 22rpx; font-weight: 600; color: #111111; white-space: nowrap; }
.cut.on { box-shadow: none; background: #EDEDEA; }
.cut.on text { color: #A5A5A0; }
.cutucou { display: flex; align-items: center; margin: 20rpx 40rpx 0; padding: 24rpx 28rpx; border-radius: 40rpx; background: #111111; }
.cutucou-e { font-size: 52rpx; animation: zo-mexe 1s ease-in-out 2; }
.cutucou-b { font-weight: 600; font-size: 28rpx; color: #FFFFFF; }
.cutucou-s { margin-top: 2rpx; font-size: 24rpx; color: rgba(255,255,255,.65); }
@keyframes zo-mexe { 0%, 100% { transform: rotate(0); } 25% { transform: rotate(-14deg); } 50% { transform: rotate(12deg); } 75% { transform: rotate(-6deg); } }

/* Campeão da semana */
.vt { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 80; background: linear-gradient(160deg, #1B1530 0%, #2A1660 45%, #8B5CF6 100%); display: flex; align-items: center; justify-content: center; overflow: hidden; animation: fl-in .25s both; }
.vt-conf { position: absolute; left: 0; right: 0; top: 0; height: 100vh; pointer-events: none; }
.vt-cf { position: absolute; top: -40rpx; border-radius: 4rpx; opacity: 0; animation-name: vt-cai; animation-timing-function: cubic-bezier(.3,.6,.5,1); animation-iteration-count: 2; animation-fill-mode: forwards; }
@keyframes vt-cai { 0% { opacity: 1; transform: translateY(0) rotate(0deg); } 85% { opacity: 1; } 100% { opacity: 0; transform: translateY(100vh) rotate(720deg); } }
.vt-luz { position: absolute; left: 50%; top: 28%; width: 1000rpx; height: 1000rpx; margin: -500rpx 0 0 -500rpx; border-radius: 999rpx; background: radial-gradient(circle, rgba(198,244,50,.42) 0%, rgba(198,244,50,0) 60%); animation: vt-pulsa 2.4s ease-in-out infinite; }
@keyframes vt-pulsa { 50% { transform: scale(1.12); opacity: .7; } }
.vt-in { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; padding: 0 48rpx; width: 100%; box-sizing: border-box; }
.vt-trofeu { font-size: 220rpx; line-height: 240rpx; animation: vt-entra .9s cubic-bezier(.2,1.6,.4,1) both, vt-balanca 2.2s 1s ease-in-out infinite; }
@keyframes vt-entra { from { transform: scale(.2) rotate(-30deg); opacity: 0; } }
@keyframes vt-balanca { 0%, 100% { transform: rotate(0) translateY(0); } 25% { transform: rotate(-6deg) translateY(-8rpx); } 75% { transform: rotate(6deg) translateY(-8rpx); } }
.vt-r { margin-top: 24rpx; font-size: 24rpx; font-weight: 700; letter-spacing: 4rpx; text-transform: uppercase; color: #C6F432; animation: sp-sobe .5s .5s both; }
.vt-tit { margin-top: 12rpx; font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 64rpx; line-height: 72rpx; letter-spacing: -2rpx; text-transform: uppercase; color: #FFFFFF; animation: sp-sobe .5s .6s both; }
.vt-v { margin-top: 12rpx; font-size: 28rpx; color: rgba(255,255,255,.65); animation: sp-sobe .5s .7s both; }
.vt-cont { display: flex; align-items: center; margin-top: 48rpx; padding: 24rpx 32rpx; border-radius: 40rpx; background: #C6F432; box-shadow: 0 24rpx 60rpx rgba(14,11,26,.45); animation: sp-sobe .5s .9s both; }
.vt-n { font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 96rpx; line-height: 100rpx; letter-spacing: -3rpx; color: #111111; min-width: 90rpx; text-align: center; }
.vt-cont-tx { display: flex; flex-direction: column; align-items: flex-start; margin-left: 20rpx; text-align: left; }
.vt-cont-b { font-weight: 700; font-size: 30rpx; color: #111111; }
.vt-cont-s { margin-top: 4rpx; font-size: 24rpx; color: #3A4A10; }
.vt-btn, button.vt-btn:not([size='mini']) { width: 100%; margin-top: 56rpx; background: #FFFFFF; color: #111111; border: none; line-height: 112rpx; animation: sp-sobe .5s 1.1s both; }
.vt-btn::after { border: none; }
.vt-nao { height: 88rpx; margin-top: 8rpx; display: flex; align-items: center; font-weight: 600; font-size: 28rpx; color: rgba(255,255,255,.7); animation: sp-sobe .5s 1.2s both; }
.taca { margin-left: 8rpx; font-size: 22rpx; font-weight: 700; color: #111111; flex-shrink: 0; }

.vt-arte { animation: sp-sobe .4s both; }
.vt-img { width: 560rpx; height: 700rpx; border-radius: 36rpx; box-shadow: 0 40rpx 90rpx rgba(14,11,26,.6); }
.vt-dois { display: flex; width: 100%; margin-top: 16rpx; }
.vt-sec, button.vt-sec:not([size='mini']) { flex: 1; height: 96rpx; line-height: 96rpx; margin: 0 6rpx; padding: 0; border-radius: 999rpx; box-shadow: inset 0 0 0 3rpx rgba(255,255,255,.35); background: transparent; color: #FFFFFF; font-weight: 600; font-size: 28rpx; text-align: center; border: none; }
.vt-sec::after { border: none; }
.vt-luz2 { position: absolute; right: -300rpx; bottom: -300rpx; width: 1000rpx; height: 1000rpx; border-radius: 999rpx; background: radial-gradient(circle, rgba(167,139,250,.7) 0%, rgba(139,92,246,0) 60%); }

/* Rostos de quem já treinou hoje (estilo stories) */
.rs-cab { display: flex; align-items: center; margin: 40rpx 40rpx 18rpx; }
.rs-t { font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 30rpx; letter-spacing: -.6rpx; color: #111111; }
.rs-n { margin-left: 12rpx; height: 40rpx; line-height: 40rpx; padding: 0 14rpx; border-radius: 999rpx; background: #C6F432; font-size: 22rpx; font-weight: 700; color: #111111; }
.rs { display: flex; flex-direction: row; white-space: nowrap; width: 100%; }
.rs-i { position: relative; display: inline-flex; flex-direction: column; align-items: center; width: 132rpx; margin-right: 12rpx; flex-shrink: 0; }
.rs .rs-i:first-child { margin-left: 32rpx; }
.rs-anel { position: relative; width: 120rpx; height: 120rpx; border-radius: 999rpx; padding: 6rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; }
.rs-anel.ok { background: linear-gradient(135deg, #C6F432 0%, #C6F432 35%, #8B5CF6 100%); }
.rs-anel.eu { background: #E4E4E0; }
.rs-av { width: 100%; height: 100%; border-radius: 999rpx; box-shadow: 0 0 0 5rpx #F2F2EF; display: flex; align-items: center; justify-content: center; color: #FFFFFF; font-weight: 600; font-size: 34rpx; }
.rs-badge { position: absolute; left: 82rpx; top: 80rpx; width: 40rpx; height: 40rpx; border-radius: 999rpx; background: #C6F432; box-shadow: 0 0 0 5rpx #F2F2EF; display: flex; align-items: center; justify-content: center; }
.rs-badge.rs-add { background: #111111; }
.rs-badge image { width: 22rpx; height: 22rpx; }
.rs-nome { margin-top: 10rpx; max-width: 128rpx; font-size: 22rpx; font-weight: 600; color: #111111; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rs-vazio { display: inline-flex; align-items: center; height: 120rpx; margin-right: 40rpx; white-space: normal; width: 440rpx; font-size: 24rpx; line-height: 34rpx; color: #7A7A76; }

/* Convite recebido */
.cvt { display: flex; align-items: center; margin: 20rpx 40rpx 0; padding: 24rpx 20rpx 24rpx 28rpx; border-radius: 40rpx; background: linear-gradient(135deg, #2A1660 0%, #8B5CF6 100%); box-shadow: 0 20rpx 50rpx rgba(42,22,96,.3); }
.cvt-e { font-size: 48rpx; }
.cvt-tx { flex: 1; min-width: 0; margin-left: 16rpx; display: flex; flex-direction: column; }
.cvt-b { font-weight: 600; font-size: 28rpx; line-height: 36rpx; color: #FFFFFF; }
.cvt-s { margin-top: 2rpx; font-size: 22rpx; color: rgba(255,255,255,.7); }
.cvt-nao { padding: 0 16rpx; font-size: 24rpx; font-weight: 600; color: rgba(255,255,255,.7); }
.cvt-sim { height: 64rpx; padding: 0 26rpx; border-radius: 999rpx; background: #C6F432; color: #111111; font-weight: 700; font-size: 26rpx; display: flex; align-items: center; flex-shrink: 0; }

/* Pedido dos avisos no chat */
@keyframes av-toca { 0%, 100% { transform: rotate(0); } 15% { transform: rotate(18deg); } 30% { transform: rotate(-16deg); } 45% { transform: rotate(12deg); } 60% { transform: rotate(-8deg); } 75% { transform: rotate(4deg); } }

/* Strava: "View on Strava" (negrito, laranja #FC5200) e "Powered by Strava" — regras de marca deles */
.fl-st-pe { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; }
.ver-st { font-weight: 700; font-size: 26rpx; color: #FC5200; padding: 8rpx 0; }
.pw-st { width: 274rpx; height: 28rpx; margin-left: auto; }

/* Ranking compacto + timeline */
.linha.sep { border-top: 2rpx dashed #E2E2DE; }
.mais { height: 88rpx; display: flex; align-items: center; justify-content: center; border-top: 2rpx solid #EEEEEA; font-weight: 600; font-size: 26rpx; color: #111111; }
.tl-vazio { display: block; margin: 0 40rpx; font-size: 26rpx; color: #7A7A76; }
.post { margin: 0 40rpx 20rpx; padding: 24rpx; border-radius: 40rpx; background: #FFFFFF; }
.post-cab { display: flex; align-items: center; }
.av-p { width: 72rpx; height: 72rpx; border-radius: 999rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; color: #FFFFFF; font-weight: 600; font-size: 26rpx; }
.post-cab .tp { width: auto; min-width: 64rpx; padding: 0 18rpx; box-sizing: border-box; font-weight: 600; font-size: 24rpx; color: #111111; }
.post-cab .tp text { margin-left: 8rpx; }
.post-foto { display: block; width: 100%; height: 560rpx; margin-top: 20rpx; border-radius: 28rpx; background: #E4E4E0; }
.post-st-card { position: relative; height: 300rpx; margin-top: 20rpx; border-radius: 28rpx; overflow: hidden; background: linear-gradient(150deg, #1B1530 0%, #2A1660 55%, #FC5200 140%); display: flex; flex-direction: column; justify-content: center; padding: 0 36rpx; }
.pst-t { font-size: 26rpx; font-weight: 600; color: rgba(255,255,255,.75); }
.pst-p { margin-top: 4rpx; font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 72rpx; letter-spacing: -2rpx; color: #C6F432; }
.pst-pw { position: absolute; right: 28rpx; bottom: 24rpx; width: 220rpx; height: 22rpx; }
.post-l { display: block; margin: 18rpx 4rpx 0; font-weight: 600; font-size: 27rpx; line-height: 38rpx; color: #111111; }
.mais-tl { margin: 0 40rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; border-radius: 999rpx; background: #E9E9E5; font-weight: 600; font-size: 26rpx; color: #111111; }

/* Folha do Strava: já salvo + editar */
.fl-ok { display: flex; align-items: center; margin-top: 16rpx; padding: 14rpx 20rpx; border-radius: 999rpx; background: rgba(198,244,50,.45); align-self: flex-start; }
.fl-ok-ck { width: 36rpx; height: 36rpx; border-radius: 999rpx; background: #C6F432; display: flex; align-items: center; justify-content: center; margin-right: 10rpx; }
.fl-ok-ck image { width: 22rpx; height: 22rpx; }
.fl-ok text { font-size: 24rpx; font-weight: 600; color: #111111; }
.fl-ed { margin-top: 16rpx; }
.fl-ed-r { display: block; margin: 16rpx 0 10rpx; font-size: 24rpx; font-weight: 600; color: #7A7A76; }
.fl-in { height: 96rpx; padding: 0 28rpx; border-radius: 28rpx; background: #FFFFFF; font-size: 30rpx; font-weight: 600; color: #111111; }
.fl-ed .quem { margin: 0; }
.quem { display: flex; flex-wrap: wrap; }
.qm { display: flex; align-items: center; height: 68rpx; padding: 0 24rpx 0 12rpx; margin: 0 12rpx 12rpx 0; border-radius: 999rpx; background: #FFFFFF; font-weight: 600; font-size: 26rpx; color: #7A7A76; }
.qm.on { color: #111111; }
.qm-ck { width: 40rpx; height: 40rpx; margin-right: 10rpx; border-radius: 999rpx; background: #EDEDEA; display: flex; align-items: center; justify-content: center; }
.qm.on .qm-ck { background: #C6F432; }
.qm-ck image { width: 24rpx; height: 24rpx; }
.fl-acoes { display: flex; margin-top: 16rpx; }
.fl-a { flex: 1; height: 88rpx; margin: 0 6rpx; border-radius: 999rpx; background: #FFFFFF; display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 26rpx; color: #111111; }

/* Bloco limão de quem ainda não treinou: chamada + botão */
.ch-topo { display: flex; align-items: center; justify-content: space-between; }
.ch-seq { height: 52rpx; padding: 0 20rpx; border-radius: 999rpx; background: #111111; display: flex; align-items: center; }
.ch-seq text { font-weight: 700; font-size: 24rpx; color: #C6F432; }
.ch-t { display: block; margin-top: 20rpx; font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 52rpx; line-height: 62rpx; letter-spacing: -1.5rpx; color: #111111; }
.ch-s { display: block; margin-top: 12rpx; font-size: 26rpx; line-height: 36rpx; color: #3A4A10; }
.ch-btn { margin-top: 32rpx; height: 100rpx; border-radius: 999rpx; background: #111111; display: flex; align-items: center; justify-content: center; }
.ch-btn image { width: 34rpx; height: 34rpx; }
.ch-btn text { margin-left: 12rpx; font-weight: 600; font-size: 30rpx; color: #FFFFFF; }
.ch-st { display: block; margin-top: 16rpx; text-align: center; font-size: 22rpx; color: #3A4A10; }

/* Sem grupo: chamada pra criar um grupo */
.cg { margin: 32rpx 40rpx 0; padding: 32rpx; border-radius: 40rpx; background: #FFFFFF; }
.cg-topo { display: flex; align-items: flex-start; }
.cg-ic { width: 88rpx; height: 88rpx; border-radius: 999rpx; background: #C6F432; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.cg-ic image { width: 46rpx; height: 46rpx; }
.cg-tx { flex: 1; min-width: 0; margin-left: 24rpx; display: flex; flex-direction: column; }
.cg-t { font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 36rpx; line-height: 44rpx; letter-spacing: -.8rpx; color: #111111; }
.cg-s { margin-top: 8rpx; font-size: 26rpx; line-height: 38rpx; color: #6A6A66; }
.cg-pe { display: flex; align-items: center; margin-top: 28rpx; }
.cg-btn { height: 88rpx; padding: 0 36rpx 0 28rpx; border-radius: 999rpx; background: #111111; display: flex; align-items: center; }
.cg-btn image { width: 30rpx; height: 30rpx; }
.cg-btn text { margin-left: 10rpx; font-weight: 600; font-size: 28rpx; color: #FFFFFF; }
.cg-cod { margin-left: 28rpx; font-weight: 600; font-size: 26rpx; color: #6A6A66; }

/* Folha de avisos no chat (sino) */
.ntf { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 75; display: flex; align-items: flex-end; }
.ntf-fundo { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background: rgba(17,17,17,.45); animation: fl-in .25s both; }
.ntf-card { position: relative; width: 100%; box-sizing: border-box; padding: 20rpx 48rpx 64rpx; border-radius: 56rpx 56rpx 0 0; background: #F2F2EF; text-align: center; animation: fl-sobe .45s cubic-bezier(.2,1.25,.4,1) both; }
.ntf-alca { width: 72rpx; height: 10rpx; margin: 0 auto 20rpx; border-radius: 999rpx; background: #D6D6D2; }
.ntf-ilu { position: relative; height: 300rpx; margin: 0 -48rpx; overflow: hidden; display: flex; align-items: center; justify-content: center; }
.ntf-luz { position: absolute; left: 50%; top: 50%; width: 520rpx; height: 520rpx; margin: -260rpx 0 0 -260rpx; border-radius: 999rpx; background: radial-gradient(circle, rgba(198,244,50,.55) 0%, rgba(139,92,246,.18) 45%, rgba(242,242,239,0) 70%); }
.ntf-sino { position: relative; font-size: 150rpx; animation: av-toca 1.2s .5s ease-in-out 2; }
.ntf-bolha { position: absolute; padding: 12rpx 22rpx; border-radius: 999rpx; background: #FFFFFF; box-shadow: 0 12rpx 30rpx rgba(17,17,17,.12); font-size: 24rpx; font-weight: 600; color: #111111; white-space: nowrap; }
.ntf-bolha.b1 { left: 64rpx; top: 56rpx; transform: rotate(-6deg); animation: sp-sobe .5s .7s both; }
.ntf-bolha.b2 { right: 56rpx; bottom: 48rpx; transform: rotate(5deg); animation: sp-sobe .5s .9s both; }
.ntf-t { display: block; margin-top: 12rpx; font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 48rpx; line-height: 56rpx; letter-spacing: -1.4rpx; color: #111111; }
.ntf-s { display: block; margin-top: 16rpx; font-size: 28rpx; line-height: 42rpx; color: #6A6A66; }
.ntf-btn { margin-top: 40rpx; height: 112rpx; border-radius: 999rpx; background: #111111; color: #FFFFFF; font-weight: 600; font-size: 32rpx; display: flex; align-items: center; justify-content: center; }
.ntf-nao { height: 80rpx; margin-top: 8rpx; display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 28rpx; color: #7A7A76; }

/* ── Subiu de nível ─────────────────────────────────────────────── */
.lv { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 85; display: flex; flex-direction: column; align-items: center; background: #0B0B0B; color: #FFFFFF; overflow: hidden; animation: lv-entra .3s ease-out both; }
@keyframes lv-entra { from { opacity: 0; } }
/* Luz de palco: acende piscando, como refletor */
.lv-luz { position: absolute; left: 0; top: 0; width: 750rpx; height: 1120rpx; opacity: 0; pointer-events: none; animation: lv-acende .9s .15s linear both; }
@keyframes lv-acende { 0% { opacity: 0; } 8% { opacity: .75; } 14% { opacity: .15; } 22% { opacity: 1; } 30% { opacity: .8; } 100% { opacity: 1; } }
.lv-cone { position: absolute; left: 0; top: -40rpx; width: 750rpx; height: 1160rpx; filter: blur(36rpx); -webkit-filter: blur(36rpx); }
.lv-cone.miolo { filter: blur(16rpx); -webkit-filter: blur(16rpx); }
.lv-cone-in { position: absolute; left: 0; top: 0; width: 100%; height: 100%; -webkit-clip-path: polygon(40% 0, 60% 0, 95% 100%, 5% 100%); clip-path: polygon(40% 0, 60% 0, 95% 100%, 5% 100%); }
.miolo .lv-cone-in { -webkit-clip-path: polygon(46% 0, 54% 0, 76% 100%, 24% 100%); clip-path: polygon(46% 0, 54% 0, 76% 100%, 24% 100%); }
.lv-po { position: absolute; width: 4rpx; height: 4rpx; border-radius: 999rpx; background: #FFF6D6; opacity: 0; pointer-events: none; animation: lv-po 6s linear infinite; }
@keyframes lv-po { 0% { opacity: 0; transform: translateY(0); } 20% { opacity: .6; } 100% { opacity: 0; transform: translateY(-440rpx); } }
.lv-palco { position: relative; width: 750rpx; height: 660rpx; margin-top: 10vh; flex-shrink: 0; perspective: 1800rpx; }
.lv-podio { position: absolute; left: 105rpx; top: 410rpx; width: 540rpx; height: 246rpx; opacity: 0; animation: lv-podio .7s .3s cubic-bezier(.2,.8,.2,1) both; }
@keyframes lv-podio { from { opacity: 0; transform: translateY(80rpx); } to { opacity: 1; transform: none; } }
.lv-poca { position: absolute; left: 185rpx; top: 476rpx; width: 380rpx; height: 68rpx; border-radius: 999rpx; background: radial-gradient(closest-side, rgba(255,246,214,.55), rgba(255,246,214,0)); opacity: 0; animation: lv-poca .8s .5s ease-out both; }
.on .lv-poca { animation: lv-poca-on 1s ease-out both; }
@keyframes lv-poca { to { opacity: .6; } }
@keyframes lv-poca-on { 0% { opacity: 1; transform: scale(1.25); } 100% { opacity: .75; transform: scale(1); } }
.lv-sombra { position: absolute; left: 265rpx; top: 488rpx; width: 220rpx; height: 36rpx; border-radius: 999rpx; background: radial-gradient(closest-side, rgba(0,0,0,.7), rgba(0,0,0,0)); opacity: 0; transition: opacity .4s; }
.on .lv-sombra { opacity: 1; animation: lv-sombra 3.2s ease-in-out infinite; }
@keyframes lv-sombra { 50% { transform: scale(.86); opacity: .75; } }
.lv-flash { position: absolute; left: 215rpx; top: 110rpx; width: 320rpx; height: 320rpx; border-radius: 999rpx; opacity: 0; }
.on .lv-flash { animation: lv-flash .9s ease-out both; }
@keyframes lv-flash { 0% { opacity: 1; transform: scale(.4); } 100% { opacity: 0; transform: scale(2.6); } }
/* O selo: cai girando (moeda), mostra o nível antigo nas costas e pousa no novo */
.lv-flutua { position: absolute; left: 195rpx; top: 80rpx; width: 360rpx; height: 414rpx; }
.on .lv-flutua { animation: lv-flutua 3.2s ease-in-out infinite; }
@keyframes lv-flutua { 50% { transform: translateY(-14rpx); } }
.lv-moeda { position: absolute; left: 0; top: 0; width: 100%; height: 100%; transform-style: preserve-3d; -webkit-transform-style: preserve-3d; opacity: 0; animation: lv-moeda 1.5s .5s cubic-bezier(.22,.7,.25,1) both; }
@keyframes lv-moeda { 0% { opacity: 0; transform: translateY(-300rpx) scale(.82) rotateY(-360deg); } 20% { opacity: 1; } 100% { opacity: 1; transform: translateY(0) scale(1) rotateY(0deg); } }
.on .lv-moeda { opacity: 1; animation: lv-pousa .5s cubic-bezier(.3,1.7,.4,1) both; }
@keyframes lv-pousa { 0% { transform: scale(1); } 30% { transform: scale(1.04, .97); } 100% { transform: scale(1); } }
/* Confete na cor do selo: estouro no centro e dois canhões nas bordas do pódio (gravidade no de fora, impulso no de dentro) */
.lv-pulo { position: absolute; left: 375rpx; top: 300rpx; width: 0; height: 0; }
.lv-pulo.esq { left: 139rpx; top: 430rpx; }
.lv-pulo.dir { left: 611rpx; top: 430rpx; }
.lv-cf { position: absolute; left: 0; top: 0; opacity: 0; }
.lv-r { position: absolute; left: 0; top: 0; }
.lv-cf-b { position: absolute; top: 0; }
.on .lv-cf { animation: lv-cai 1.8s cubic-bezier(.55,0,1,.6) both; }
.on .lv-cf-b { animation: lv-sai 1.8s cubic-bezier(.1,.75,.3,1) both; }
.on .lv-cf.m .lv-cf-b { animation-name: lv-sai2; }
.on .lv-cf.l .lv-cf-b { animation-name: lv-sai3; }
@keyframes lv-cai { 0% { opacity: 1; transform: translateY(0); } 78% { opacity: 1; } 100% { opacity: 0; transform: translateY(480rpx); } }
@keyframes lv-sai { 0% { transform: translateY(0) rotate(0); } 100% { transform: translateY(-300rpx) rotate(540deg); } }
@keyframes lv-sai2 { 0% { transform: translateY(0) rotate(0); } 100% { transform: translateY(-190rpx) rotate(-420deg); } }
@keyframes lv-sai3 { 0% { transform: translateY(0) rotate(0); } 100% { transform: translateY(-460rpx) rotate(720deg); } }
.lv-lado { position: absolute; left: 0; top: 0; width: 100%; height: 100%; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
.lv-lado.tras { transform: rotateY(180deg); }
.lv-lado image { width: 100%; height: 100%; display: block; }
.lv-n { position: absolute; left: 0; right: 0; top: 44%; margin-top: -76rpx; height: 152rpx; line-height: 152rpx; text-align: center; font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 108rpx; letter-spacing: 0; color: #121212; text-shadow: 0 4rpx 0 rgba(255,255,255,.45); white-space: nowrap; }
.lv-brilho { position: absolute; left: 375rpx; top: 312rpx; width: 0; height: 0; }
.lv-est { position: absolute; width: 28rpx; height: 28rpx; margin: -14rpx; font-size: 28rpx; line-height: 28rpx; color: #FFF6D6; opacity: 0; }
.on .lv-est { animation: lv-est 2.4s ease-in-out infinite; }
@keyframes lv-est { 0%, 100% { opacity: 0; transform: scale(.3); } 40% { opacity: 1; transform: scale(1); } 60% { opacity: .9; transform: scale(.8); } }
.lv-tx { position: relative; display: flex; flex-direction: column; align-items: center; margin-top: 8rpx; }
.lv-topo { font-size: 26rpx; font-weight: 600; letter-spacing: 6rpx; text-transform: uppercase; }
.lv-faixa { margin-top: 20rpx; padding: 0 48rpx; text-align: center; font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 64rpx; line-height: 76rpx; letter-spacing: -2rpx; }
.lv-frase { margin-top: 20rpx; max-width: 600rpx; text-align: center; font-size: 30rpx; line-height: 42rpx; color: rgba(255,255,255,.66); }
.lv-recs { width: 622rpx; margin-top: 44rpx; }
.lv-rec { display: flex; align-items: center; height: 88rpx; border-top: 2rpx solid rgba(255,255,255,.1); font-size: 30rpx; font-weight: 500; }
.lv-rec-p { width: 16rpx; height: 16rpx; border-radius: 999rpx; margin-right: 28rpx; flex-shrink: 0; }
.lv-topo, .lv-faixa, .lv-frase, .lv-rec { opacity: 0; transform: translateY(28rpx); transition: all .6s cubic-bezier(.2,.9,.2,1); }
.lv-faixa { transition-delay: .06s; }
.lv-frase { transition-delay: .14s; }
.lv-pe { position: relative; width: 622rpx; margin-top: auto; padding-bottom: calc(52rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; align-items: center; opacity: 0; transform: translateY(32rpx); transition: all .6s .45s cubic-bezier(.2,.9,.2,1); }
.lv-btn { width: 100%; height: 112rpx; border-radius: 999rpx; display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 32rpx; color: #111111; }
.lv-fechar { display: flex; align-items: center; height: 96rpx; margin-top: 8rpx; padding: 0 24rpx; font-size: 30rpx; font-weight: 500; color: rgba(255,255,255,.7); }
.lv-fechar text { padding: 0 16rpx; }
.lv-ponto { opacity: .5; }
.on .lv-topo, .on .lv-faixa, .on .lv-frase, .on .lv-rec, .on .lv-pe { opacity: 1; transform: none; }
.lv-arte { position: absolute; left: 0; right: 0; top: 0; bottom: 0; display: flex; flex-direction: column; align-items: center; animation: lv-sobe .4s both; }
@keyframes lv-sobe { from { opacity: 0; transform: translateY(24rpx); } }
.lv-meio { flex: 1; width: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; padding-top: 120rpx; box-sizing: border-box; }
.lv-arte-t { margin-top: 0; font-family: "Unbounded", "Poppins", sans-serif; font-weight: 800; font-size: 36rpx; line-height: 44rpx; letter-spacing: -1rpx; color: #FFFFFF; }
.lv-img { margin-top: 32rpx; width: 600rpx; height: 750rpx; border-radius: 32rpx; }
.lv-arte-s { margin-top: 24rpx; font-size: 26rpx; line-height: 36rpx; color: rgba(255,255,255,.55); }

/* Tema do dia: faixa no topo e ilustração no card (tudo vem do servidor) */
.tm-faixa { display: flex; align-items: center; margin: 24rpx 40rpx 0; padding: 20rpx 28rpx 20rpx 20rpx; border-radius: 36rpx; background: #FFFFFF; }
.tm-faixa-img { width: 88rpx; height: 100rpx; flex-shrink: 0; margin-right: 20rpx; }
.tm-faixa-tx { display: flex; flex-direction: column; min-width: 0; }
.tm-faixa-t { font-weight: 700; font-size: 30rpx; line-height: 40rpx; color: #111111; }
.tm-faixa-s { margin-top: 4rpx; font-size: 25rpx; line-height: 34rpx; color: #55554F; }
.dia-ilu { position: absolute; right: 0; top: 0; width: 40%; pointer-events: none; }
.dia.ilu .ch-t, .dia.ilu .ch-s { padding-right: 34%; } /* texto não passa por baixo da ilustração */
.rs-enf { padding-top: 64rpx; } /* espaço pro enfeite (chapéu) não ser cortado */
