<view class="tela-b">
  <view class="barra" style="padding-top: {{barTop}}px; height: {{barH}}px">
    <view class="barra-voltar" style="top: {{barTop - 4}}px" bindtap="voltar"><image src="{{ic.VOLTAR}}" mode="aspectFit"></image></view>
    <text class="barra-tit">Registrar treino</text>
  </view>

  <view class="cam" style="margin-top: 24rpx" bindtap="tocarCam">
    <image wx:if="{{foto}}" class="cam-img" src="{{foto}}" mode="aspectFill"></image>
    <view wx:else class="cam-vazia">
      <image class="cam-ic" src="{{ic.CAMERA_PRETA}}" mode="aspectFit"></image>
      <text class="cam-tit pop">{{recusada ? "Tira outra?" : "Tire a foto do treino"}}</text>
      <text class="cam-tx {{recusada ? 'cam-rec' : ''}}">{{recusada || "Sem foto, o treino à mão não entra"}}</text>
    </view>
    <view class="cam-pe">
      <text class="cam-tag">{{foto ? "Agora · " + hora : "Foto na hora, sem galeria"}}</text>
      <view wx:if="{{foto}}" class="cam-refazer" catchtap="tirarFoto">Tirar outra</view>
      <view wx:else class="cam-disparo"><view class="cam-disparo-in"></view></view>
    </view>
  </view>

  <text class="sec">Quanto tempo</text>
  <view class="stepper">
    <view class="stepper-b" bindtap="menos" hover-class="tp-press">−</view>
    <text class="stepper-v pop">{{min}} min</text>
    <view class="stepper-b" bindtap="mais" hover-class="tp-press">+</view>
  </view>
  <text class="sec">O que você fez</text>
  <!-- Tipos em grade: ícone na frente do nome; o escolhido fica limão -->
  <view class="tps">
    <view wx:for="{{tipos}}" wx:key="k" class="tp-t {{tipo === item.k ? 'on' : ''}}" data-k="{{item.k}}" bindtap="escolherTipo" hover-class="tp-press">
      <view class="tp-ic"><image src="{{item.ic}}" mode="aspectFit"></image></view>
      <text class="tp-l">{{item.l}}</text>
    </view>
  </view>

  <block wx:if="{{comKm}}">
    <text class="sec">Distância</text>
    <view class="stepper">
      <view class="stepper-b" bindtap="menosKm" hover-class="tp-press">−</view>
      <text class="stepper-v pop">{{kmTxt}}</text>
      <view class="stepper-b" bindtap="maisKm" hover-class="tp-press">+</view>
    </view>
  </block>
  <!-- Quem pode ver (os pontos contam sempre) -->
  <block wx:if="{{quem.length}}">
    <text class="sec">Quem pode ver</text>
    <view class="quem">
      <view wx:for="{{quem}}" wx:key="id" class="qm {{item.on ? 'on' : ''}}" data-i="{{index}}" bindtap="alternarQuem">
        <view class="qm-ck"><image wx:if="{{item.on}}" src="{{ic.CHECK_PRETO}}" mode="aspectFit"></image></view>
        <text>{{item.nome}}</text>
      </view>
    </view>
    <text class="nota" style="margin-top: 12rpx">Os pontos contam sempre. Isso só escolhe em que timeline o treino aparece.</text>
  </block>
  <text class="nota">Treino à mão conta até {{maxDia}} min por dia, 2 por dia. A foto é conferida na hora e aparece no ranking.</text>
  <text class="erro" wx:if="{{erro}}">{{erro}}</text>
  <view style="height: 240rpx"></view>

  <view class="rodape">
    <view class="btn {{foto && !enviando ? '' : 'off'}}" bindtap="registrar" hover-class="btn-press">
      {{enviando ? "Conferindo a foto…" : (foto ? "Registrar treino" : "Tire a foto pra registrar")}}
    </view>
  </view>

  <!-- Foto recusada: zoeira por cima do conteúdo -->
  <view class="zo" wx:if="{{zoeira}}" catchtouchmove="nada">
    <view class="zo-fundo" bindtap="fecharZoeira"></view>
    <view class="zo-card">
      <text class="zo-emoji">{{zoeira.emoji}}</text>
      <text class="zo-tit">{{zoeira.titulo}}</text>
      <text class="zo-tx">{{zoeira.motivo}}</text>
      <view class="btn zo-btn" bindtap="outraFoto" hover-class="btn-press">Tirar outra foto</view>
      <view class="zo-nao" bindtap="fecharZoeira">Fechar</view>
    </view>
  </view>
</view>
