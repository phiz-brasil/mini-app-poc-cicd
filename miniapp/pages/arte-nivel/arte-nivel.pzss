page { background: #0B0B0B; }
.an { position: relative; min-height: 100vh; display: flex; flex-direction: column; align-items: center; background: #0B0B0B; color: #FFFFFF; overflow: hidden; }
.an-luz { position: absolute; left: 75rpx; top: 120rpx; width: 600rpx; height: 600rpx; border-radius: 999rpx; }
.an .barra { align-self: stretch; }
.an-tit { color: #FFFFFF; }
.an-meio { position: relative; flex: 1; width: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.an-img { position: relative; width: 600rpx; height: 750rpx; border-radius: 32rpx; }
.an-vazia { background: rgba(255,255,255,.06); }
.an-sub { position: relative; margin-top: 32rpx; max-width: 560rpx; text-align: center; font-size: 28rpx; line-height: 40rpx; color: rgba(255,255,255,.7); }
.an-aviso { position: relative; margin-top: 16rpx; max-width: 560rpx; text-align: center; font-size: 26rpx; line-height: 36rpx; color: #FFFFFF; }
.an-pe { position: relative; width: 622rpx; padding: 24rpx 0 calc(40rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; align-items: center; }
.an-btn { width: 100%; height: 112rpx; border-radius: 999rpx; display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 32rpx; color: #111111; }
.an-link { display: flex; align-items: center; height: 96rpx; margin-top: 8rpx; padding: 0 24rpx; font-size: 30rpx; font-weight: 500; color: rgba(255,255,255,.7); }
