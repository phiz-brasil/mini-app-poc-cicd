<view class="an">
  <view class="an-luz" style="background: radial-gradient(closest-side, {{ac}}40, {{ac}}00)"></view>
  <view class="barra" style="padding-top: {{barTop}}px; height: {{barH}}px">
    <view class="barra-voltar" style="top: {{barTop - 4}}px" bindtap="voltar"><image src="{{ic.VOLTAR_BRANCO}}" mode="aspectFit"></image></view>
    <text class="barra-tit an-tit">{{titulo || "Arte do meu nível"}}</text>
  </view>

  <view class="an-meio">
    <image wx:if="{{arte}}" class="an-img" src="{{arte}}" mode="aspectFit" bindtap="ampliar"></image>
    <view wx:else class="an-img an-vazia"></view>
    <text class="an-sub" wx:if="{{sub}}">{{sub}}</text>
    <text class="an-sub" wx:elif="{{n}}">Nível {{n}} · {{faixa}}. Poste e mostre pra galera que tá pago.</text>
    <text class="an-aviso" wx:if="{{aviso}}">{{aviso}}</text>
  </view>

  <view class="an-pe">
    <view class="an-btn" style="background: {{ac}}" bindtap="postar" hover-class="btn-press">{{ocupado === 'post' ? "Salvando…" : "Salvar pra postar no Moments"}}</view>
    <text class="an-link" bindtap="salvar">{{ocupado === 'salvar' ? "Salvando…" : "Salvar imagem"}}</text>
  </view>
</view>
