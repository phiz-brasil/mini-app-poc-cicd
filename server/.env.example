# Armazenamento (Vercel Blob, store privado). `vercel env pull` traz o valor.
BLOB_READ_WRITE_TOKEN=

# OpenAPI de Clipes e Momentos (guia v1.4). Só no servidor.
PHIZ_OPENAPI_HOST=            # ex.: openapi.phizchat.com (sem https://)
PHIZ_APP_ID=
PHIZ_APP_SECRET=
PHIZ_ROBOT_ID=                # opcional: se vazio, usa o 1º robô de /robot/list

# Contrato do Momento: o guia diz "per downstream contract". Ajustar quando o
# time da Open Platform confirmar os valores.
PHIZ_MOMENT_TYPE=1
PHIZ_MOMENT_MEDIA_TYPE_IMAGE=1

# Senha do /admin (a mesma dos sites internos do time)
ADMIN_SENHA=
SUPORTE_EMAIL=
